<h1><%= @is_reforward ? "Request re-forwarded" : "Request forwarded" %></h1>
<p>
  <% if @is_reforward %>
    The supervisor clarified this request after your earlier feedback and re-forwarded it for your review.
  <% else %>
    The supervisor approved this request and forwarded it for your review.
  <% end %>
</p>
<%= render "details" %>
