<h1><%= @is_reforward ? "Request re-forwarded" : "Request forwarded" %></h1>
<p>
  <% if @is_reforward %>
    <%= @actor_role_label %> clarified this request after your earlier feedback and re-forwarded it for your review.
  <% else %>
    <%= @actor_role_label %> approved this request and forwarded it for your review.
  <% end %>
</p>
<%= render "details" %>
