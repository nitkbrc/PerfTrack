<h1>Request approved</h1>
<p>
  <% if @recipient.id == @student.user_id %>
    Your SCATS request has been approved by the dean<%= @request.points_awarded.present? ? " (#{@request.points_awarded} points awarded)" : "" %>.
  <% else %>
    A SCATS request you forwarded on behalf of
    <%= @student.user.name.presence || @student.usn %>
    has been approved by the dean<%= @request.points_awarded.present? ? " (#{@request.points_awarded} points awarded)" : "" %>.
  <% end %>
</p>
<%= render "details" %>
