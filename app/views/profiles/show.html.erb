<div class="mx-auto max-w-2xl">
  <section class="clay-card p-6 sm:p-8">
    <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
      <%= user_photo_tag(@user, size: 104) %>
      <div>
        <h1 class="text-3xl font-bold text-[#000666]"><%= @user.name.presence || "SCATS user" %></h1>
        <p class="mt-1 text-slate-600"><%= @user.email %></p>
        <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
          <% user_role_labels(@user).each do |label| %>
            <span class="<%= user_role_badge_classes %>"><%= label %></span>
          <% end %>
        </div>
      </div>
    </div>

    <dl class="mt-8 grid gap-5 border-t border-[#000666]/10 pt-6 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Phone</dt>
        <dd class="mt-1 text-slate-800"><%= @user.phone %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Address</dt>
        <dd class="mt-1 text-slate-800"><%= @user.address %></dd>
      </div>

      <% if @user.admin? %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Responsibility</dt>
          <dd class="mt-1 text-slate-800">System-wide administration (all divisions and users)</dd>
        </div>
      <% end %>

      <% if @user.deaned_divisions.any? %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Dean of <%= "division".pluralize(@user.deaned_divisions.size) %>
          </dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            <% @user.deaned_divisions.order(:name).each do |division| %>
              <span class="inline-flex items-center rounded-full border border-[#000666]/15 bg-[#e0e0ff]/70 px-3 py-1 text-sm font-medium text-[#000666]">
                <%= division.name %>
                <span class="ml-1.5 text-xs font-normal text-slate-500">(<%= division.div_type.titleize %>)</span>
              </span>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if @user.supervised_sub_divisions.any? %>
        <div class="sm:col-span-2">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Supervisor of <%= "sub-division".pluralize(@user.supervised_sub_divisions.size) %>
          </dt>
          <dd class="mt-2 flex flex-wrap gap-2">
            <% @user.supervised_sub_divisions.sort_by(&:name).each do |sub_division| %>
              <span class="inline-flex items-center rounded-full border border-[#000666]/15 bg-[#e0e0ff]/70 px-3 py-1 text-sm font-medium text-[#000666]">
                <%= sub_division.name %>
                <span class="ml-1.5 text-xs font-normal text-slate-500">· <%= sub_division.division.name %></span>
              </span>
            <% end %>
          </dd>
        </div>
      <% end %>

      <% if @user.student_profile %>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">USN</dt>
          <dd class="mt-1 text-slate-800"><%= @user.student_profile.usn %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Department / semester</dt>
          <dd class="mt-1 text-slate-800">
            <%= @user.student_profile.department.name %> · Semester <%= @user.student_profile.sem %>
          </dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to "Change password", edit_account_password_path, class: "scats-primary-button" %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "cursor-pointer rounded-xl border border-[#000666]/20 px-4 py-2 text-sm font-semibold text-[#000666] transition hover:bg-[#000666]/5" %>
    </div>
  </section>
</div>
