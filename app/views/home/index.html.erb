<div class="mx-auto w-full max-w-md">
  <div class="rounded-xl bg-white p-8 text-center shadow-md ring-1 ring-slate-200">
    <h1 class="text-2xl font-bold text-slate-900">SCATS</h1>
    <p class="mt-1 text-sm text-slate-500">Student Character and Achievement Tracking System</p>

    <% if user_signed_in? %>
      <div class="mt-6 space-y-2">
        <p class="text-sm text-slate-700">
          Signed in as <span class="font-semibold"><%= current_user.email %></span>
        </p>
        <span class="inline-block rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700"><%= current_user.role %></span>
      </div>
      <div class="mt-6 flex items-center justify-center gap-4">
        <% if current_user.admin? %>
          <%= link_to "Admin panel", admin_root_path,
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
        <% end %>
        <% if current_user.student? && current_user.student_profile %>
          <%= link_to "My dashboard", student_root_path,
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
        <% end %>
        <% if current_user.faculty? && current_user.supervised_sub_divisions.exists? %>
          <%= link_to "Supervisor panel", supervisor_root_path,
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
        <% end %>
        <% if current_user.faculty? && current_user.deaned_divisions.exists? %>
          <%= link_to "Dean panel", dean_root_path,
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
        <% end %>
        <%= link_to "Change password", edit_account_password_path,
              class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "cursor-pointer rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700" %>
      </div>
    <% else %>
      <div class="mt-6 flex items-center justify-center gap-3">
        <%= link_to "Log in", new_user_session_path,
              class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
