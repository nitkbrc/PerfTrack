<div class="mx-auto grid min-h-[75vh] w-full max-w-5xl place-items-center lg:grid-cols-2 lg:gap-16">
  <section class="glass-panel w-full max-w-lg p-7 text-center lg:text-left">
    <p class="mb-3 text-sm font-bold uppercase tracking-[.25em] text-[#2D6A4F]">Student life, recognised</p>
    <h1 class="text-5xl font-bold tracking-tight text-[#1B4332]">Welcome to SCATS</h1>
    <p class="mt-5 max-w-lg text-lg leading-8 text-slate-600">Student Character and Achievement Tracking System brings achievements, requests, and decisions into one thoughtful place.</p>
  </section>
  <section class="glass-panel w-full max-w-md p-7">
    <h2 class="text-2xl font-bold text-[#1B4332]">Sign in</h2>
    <p class="mt-1 text-sm text-slate-600">Use your SCATS account to continue.</p>
    <%= form_with scope: :user, url: user_session_path, class: "mt-6 space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "mt-1 w-full rounded-xl border-slate-200 bg-white/80 px-3 py-2.5 focus:border-[#74C69D] focus:ring-[#74C69D]" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "mt-1 w-full rounded-xl border-slate-200 bg-white/80 px-3 py-2.5 focus:border-[#74C69D] focus:ring-[#74C69D]" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-[#1B4332] focus:ring-[#74C69D]" %>
        <%= f.label :remember_me, class: "text-sm text-slate-700" %>
      </div>
      <%= f.submit "Sign in", class: "scats-primary-button w-full" %>
    <% end %>
  </section>
</div>
