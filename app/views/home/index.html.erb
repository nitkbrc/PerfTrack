<div class="flex min-h-screen flex-col">
  <div class="grid min-h-0 w-full flex-1 grid-cols-1 lg:grid-cols-5">
    <section class="scats-auth-campus relative lg:col-span-2"
             data-controller="campus-rotator"
             data-campus-rotator-full-value="true">
      <% campus_image_paths.each_with_index do |path, index| %>
        <%= image_tag path, data: { campus_rotator_target: "image" },
              class: "absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 #{index.zero? ? '' : 'opacity-0'}",
              alt: "" %>
      <% end %>
      <div class="absolute inset-0 bg-primary/50"></div>
      <div class="relative z-10 flex h-full flex-col justify-end p-8 text-white sm:p-10 lg:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-on-primary-container">Student life, recognised</p>
        <h1 class="mt-3 max-w-sm text-3xl font-bold tracking-tight sm:text-4xl">
          Welcome to SCATS
        </h1>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-white/80 sm:text-base">
          Student Character and Achievement Tracking System brings achievements, requests, and decisions into one thoughtful place.
        </p>
      </div>
    </section>

    <section class="scats-auth-form-panel lg:col-span-3">
      <div class="mx-auto w-full max-w-md">
        <% provide :inline_auth_flash, "1" %>
        <%= render "shared/flash", width_classes: "" %>

        <p class="text-xs font-bold uppercase tracking-[0.3em] text-secondary">SCATS</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-primary">Sign in</h2>
        <p class="mt-2 text-sm text-text-muted">Use your SCATS account to continue.</p>

        <%= form_with scope: :user, url: user_session_path, class: "mt-8 space-y-5" do |f| %>
          <div>
            <%= f.label :email, class: admin_label_classes %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  class: "#{admin_input_classes} mt-1" %>
          </div>
          <div>
            <%= f.label :password, class: admin_label_classes %>
            <%= f.password_field :password, autocomplete: "current-password",
                  class: "#{admin_input_classes} mt-1" %>
          </div>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me,
                  class: "h-4 w-4 shrink-0 rounded border-border-subtle text-primary focus:ring-2 focus:ring-secondary-container/40" %>
            <%= f.label :remember_me, class: "text-sm text-text-main" %>
          </div>
          <%= f.submit "Sign in", class: "scats-primary-button w-full" %>
        <% end %>
      </div>
    </section>
  </div>

  <footer class="scats-footer shrink-0" role="contentinfo">
    <div class="scats-footer-inner scats-footer-inner--landing">
      <div class="scats-footer-brand">
        <div class="scats-footer-identity">
          <span class="scats-footer-name">SCATS</span>
          <span class="scats-footer-tagline">Student Character and Achievement Tracking System</span>
        </div>
      </div>

      <p class="scats-footer-motto">
        So nothing gets lost to memory — achievements or conduct.
      </p>

      <p class="scats-footer-meta">
        &copy; <%= Date.current.year %> SCATS
      </p>
    </div>
  </footer>
</div>
