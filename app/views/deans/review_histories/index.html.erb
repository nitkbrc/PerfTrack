<div class="mx-auto w-full max-w-4xl">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Review history</h1>
    <p class="mt-1 text-sm text-slate-500">Requests you have already decided on.</p>
  </div>

  <% if @histories.any? %>
    <div class="clay-card scats-list-shell">
      <ul class="scats-list divide-y divide-slate-100">
        <% @histories.each do |history| %>
          <% request_record = history.achievement_request %>
          <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div class="min-w-0">
              <p class="text-sm text-slate-800">
                You <%= review_history_verb(history.action) %>
                <span class="font-semibold"><%= history.request_version.title.presence || request_record.title %></span>
                on <%= history.created_at.strftime("%d %b %Y") %>
              </p>
              <p class="mt-0.5 text-xs text-slate-500">
                Student <%= request_record.student.usn %>
              </p>
            </div>
            <%= link_to "View timeline", dean_achievement_request_path(request_record),
                  class: "shrink-0 text-sm font-medium text-[#000666] hover:text-[#1a237e]" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-500 shadow-md ring-1 ring-slate-200">
      You haven't decided on any requests yet.
    </p>
  <% end %>
</div>
