<div class="mx-auto w-full max-w-3xl">
  <div class="mb-6">
    <%= link_to dean_queue_path, class: "scats-secondary-button gap-1.5" do %>
      <span class="material-symbols-outlined text-base leading-none" aria-hidden="true">arrow_back</span>
      Back to queue
    <% end %>
  </div>

  <div class="clay-card p-8">
    <%= render "shared/achievement_request_details",
          achievement_request: @achievement_request, histories: @histories %>
  </div>

  <% if @achievement_request.in_review? && @achievement_request.current_reviewer&.id == current_user.id %>
    <% final_step = @achievement_request.next_step.nil? %>
    <div class="clay-card mt-6 p-6 sm:p-8"
         data-controller="panel-switch"
         data-panel-switch-mode-value="approve">
      <h2 class="mb-1 text-lg font-semibold text-slate-900">Your decision</h2>
      <% if final_step %>
        <p class="mb-4 text-sm text-slate-500">
          Approving awards
          <span class="font-semibold <%= @achievement_request.category.sub_division.division.positive? ? 'text-green-700' : 'text-red-700' %>">
            <%= @achievement_request.category.sub_division.division.positive? ? "+" : "-" %><%= @achievement_request.category.points %> points
          </span>
          to <%= @achievement_request.student.usn %> — final and irreversible.
        </p>
      <% else %>
        <p class="mb-4 text-sm text-slate-500">Advance this request to the next reviewer in the chain.</p>
      <% end %>

      <div class="mb-6">
        <div class="scats-switch w-full"
             role="tablist"
             aria-label="Decision action"
             data-controller="segmented-switch"
             data-segmented-switch-selected-value="approve"
             data-action="segmented-switch:change->panel-switch#select">
          <span class="scats-switch__pill" data-segmented-switch-target="pill" aria-hidden="true"></span>
          <button type="button" role="tab" data-segmented-switch-target="option" data-value="approve"
                  data-action="segmented-switch#select keydown->segmented-switch#keydown"
                  class="scats-switch__option"><%= final_step ? "Approve" : "Advance" %></button>
          <button type="button" role="tab" data-segmented-switch-target="option" data-value="revert"
                  data-action="segmented-switch#select keydown->segmented-switch#keydown"
                  class="scats-switch__option">Revert</button>
          <button type="button" role="tab" data-segmented-switch-target="option" data-value="reject"
                  data-action="segmented-switch#select keydown->segmented-switch#keydown"
                  class="scats-switch__option">Reject</button>
        </div>
      </div>

      <div data-panel-switch-target="panel" data-mode="approve" role="tabpanel">
        <%= button_to final_step ? "Approve — award points" : "Advance to next reviewer",
              approve_dean_achievement_request_path(@achievement_request), method: :patch,
              data: (final_step ? { turbo_confirm: "Approve and snapshot the points? This cannot be undone." } : {}),
              class: "cursor-pointer rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-green-500" %>
      </div>

      <div data-panel-switch-target="panel" data-mode="revert" role="tabpanel" class="hidden" aria-hidden="true">
        <p class="mb-3 text-sm text-slate-500">Send this back to the previous reviewer with a message (required).</p>
        <%= render "shared/decision_form",
              url: revert_dean_achievement_request_path(@achievement_request),
              button_label: "Revert for clarification",
              button_classes: "bg-orange-500 hover:bg-orange-400",
              reason_templates: @reason_templates,
              comment_label: "Message" %>
      </div>

      <div data-panel-switch-target="panel" data-mode="reject" role="tabpanel" class="hidden" aria-hidden="true">
        <p class="mb-3 text-sm text-slate-500">Rejecting is final — no points will be awarded.</p>
        <%= render "shared/decision_form",
              url: reject_dean_achievement_request_path(@achievement_request),
              button_label: "Reject",
              button_classes: "bg-red-600 hover:bg-red-500",
              confirm: "Rejecting is final — no points will be awarded. Continue?",
              reason_templates: @reason_templates,
              comment_label: "Message" %>
      </div>
    </div>
  <% end %>
</div>
