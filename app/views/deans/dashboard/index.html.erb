<div class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <div class="relative overflow-hidden rounded-3xl p-8 shadow-xl lg:col-span-2"
         style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%); min-height: 200px;">
      <div class="pointer-events-none absolute right-0 top-0 h-64 w-64 rounded-full opacity-20"
           style="background: radial-gradient(circle at top right, #93c5fd, transparent 65%)"></div>

      <div class="relative flex h-full flex-col justify-center gap-2">
        <p class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
          <%= current_user.name.presence || current_user.email %>
        </p>
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white">
          <%= chrome_role_label(current_user) %>
        </p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-white">Your divisions</p>
        <% if @divisions.any? %>
          <div class="mt-1 flex flex-wrap gap-2">
            <% @divisions.each do |division| %>
              <span class="rounded-lg border border-white/30 bg-white/10 px-3 py-1.5 text-sm font-semibold text-white backdrop-blur-sm">
                <%= division.name %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-white">No divisions assigned</p>
        <% end %>
      </div>
    </div>

    <div class="clay-card flex flex-col justify-center gap-3 rounded-3xl p-6">
      <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-400">Quick links</p>
      <%= link_to "Open decision queue", dean_queue_path, class: "scats-primary-button w-full" %>
      <%= link_to "Review history", dean_review_histories_path, class: "scats-secondary-button w-full" %>
      <%= link_to "Students directory", faculty_students_path, class: "scats-ghost-button w-full" %>
    </div>
  </div>

  <section>
    <h2 class="mb-3 text-sm font-semibold text-text-main">Your divisions</h2>
    <div class="grid auto-rows-[minmax(7rem,auto)] grid-cols-2 gap-4 lg:grid-cols-4">
      <%= render "shared/stat_tile",
            icon: "fact_check", tone: :amber, variant: :feature,
            span: "col-span-2 row-span-2",
            value: @awaiting_decision, label: "Awaiting decision",
            sub: "Forwarded by supervisors and waiting on you",
            href: dean_queue_path %>
      <%= render "shared/stat_tile",
            icon: "verified", tone: :emerald,
            value: @accepted, label: "Accepted" %>
      <%= render "shared/stat_tile",
            icon: "block", tone: :red,
            value: @rejected, label: "Rejected" %>
      <%= render "shared/stat_tile",
            icon: "history", tone: :indigo,
            span: "col-span-2",
            value: @history_count, label: "Your review history",
            sub: "Decisions you have recorded",
            href: dean_review_histories_path %>
    </div>
  </section>

  <%= render "shared/dean_hierarchy_tree", divisions: @divisions %>

  <section>
    <h2 class="mb-3 text-sm font-semibold text-text-main">Campus</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <%= render "shared/stat_tile",
            icon: "school", tone: :sky,
            value: @student_count, label: "Students",
            href: faculty_students_path %>
      <%= render "shared/stat_tile",
            icon: "grid_view", tone: :violet,
            value: @department_count, label: "Departments" %>
      <%= render "shared/stat_tile",
            icon: "group", tone: :blue,
            value: @faculty_count, label: "Faculty" %>
    </div>
  </section>
</div>
