<% selected_category = @achievement_request.category %>
<% selected_sub_division = selected_category&.sub_division %>
<% selected_division = selected_sub_division&.division %>
<%# On validation failure we land back at step 3 — detect via errors present %>
<% start_step = @achievement_request.errors.any? ? 3 : 1 %>
<% start_polarity = selected_division&.positive? ? "positive" : (selected_division&.negative? ? "negative" : nil) %>
<% category_chosen = @achievement_request.category_id.present? %>

<div class="mx-auto w-full max-w-2xl px-4 py-8"
     data-controller="raise-wizard"
     data-raise-wizard-tree-value="<%= @division_tree.to_json %>"
     data-raise-wizard-step-value="<%= start_step %>"
     <% if start_polarity.present? %>data-raise-wizard-polarity-value="<%= start_polarity %>"<% end %>>

  <%# ── Progress stepper ───────────────────────────────────────────────────── %>
  <% wizard_steps = [
       ["1", "Request Type", "Type"],
       ["2", "Choose Category", "Category"],
       ["3", "Details & Proof", "Details"]
     ] %>
  <div class="mb-8 rounded-2xl border border-slate-200 bg-white px-3 py-5 shadow-sm sm:px-6">
    <div class="flex">
      <% wizard_steps.each_with_index do |(num, label, short_label), i| %>
        <% step_num = i + 1 %>
        <% completed = start_step > step_num %>
        <% active = start_step == step_num %>
        <div data-raise-wizard-target="progressStep" class="flex min-w-0 flex-1 flex-col items-center">
          <div class="flex w-full items-center">
            <% if i > 0 %>
              <div data-raise-wizard-target="progressConnector"
                   class="h-px flex-1 bg-slate-200 transition-colors duration-200"></div>
            <% else %>
              <div class="flex-1" aria-hidden="true"></div>
            <% end %>

            <span data-progress-icon
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 text-sm font-bold transition-colors duration-200 <%= completed || active ? "border-transparent text-white" : "border-slate-200 text-slate-400" %>"
                  style="background-color: <%= completed ? "#16a34a" : (active ? "#2563eb" : "#ffffff") %>">
              <span data-progress-number
                    class="<%= completed ? "hidden" : "" %>"
                    <%= completed ? 'aria-hidden="true"' : "" %>><%= num %></span>
              <span data-progress-check
                    class="material-symbols-outlined text-[20px] leading-none <%= completed ? "" : "hidden" %>"
                    <%= completed ? "" : 'aria-hidden="true"' %>>check</span>
            </span>

            <% if i < wizard_steps.length - 1 %>
              <div data-raise-wizard-target="progressConnector"
                   class="h-px flex-1 bg-slate-200 transition-colors duration-200"></div>
            <% else %>
              <div class="flex-1" aria-hidden="true"></div>
            <% end %>
          </div>

          <span data-progress-label
                class="mt-2 max-w-[5.5rem] text-center text-[11px] font-semibold leading-tight transition-colors duration-200 sm:max-w-none sm:text-xs"
                style="color: <%= completed ? "#16a34a" : (active ? "#2563eb" : "#94a3b8") %>">
            <span class="sm:hidden"><%= short_label %></span>
            <span class="hidden sm:inline"><%= label %></span>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── Step 1: Request type (Achievement vs Conduct) ─────────────────────── %>
  <div data-raise-wizard-target="step1">
    <div class="mb-6 text-center">
      <h1 class="text-2xl font-bold text-[#000666]">What are you submitting?</h1>
      <p class="mt-1 text-sm text-slate-500">Choose whether this is an achievement or a conduct matter.</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <button type="button"
              data-polarity="positive"
              data-action="click->raise-wizard#selectPolarity"
              class="clay-card group flex w-full flex-col gap-4 rounded-2xl p-6 text-left transition hover:border-emerald-200 hover:shadow-md cursor-pointer">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 transition group-hover:bg-emerald-100">
          <span class="material-symbols-outlined text-[26px] text-emerald-600" style="font-variation-settings:'FILL' 1">emoji_events</span>
        </div>
        <div>
          <p class="text-base font-bold text-[#000666]">Achievement submission</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-500">Recognise accomplishments, awards, and positive contributions.</p>
        </div>
      </button>

      <button type="button"
              data-polarity="negative"
              data-action="click->raise-wizard#selectPolarity"
              class="clay-card group flex w-full flex-col gap-4 rounded-2xl p-6 text-left transition hover:border-amber-200 hover:shadow-md cursor-pointer">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 transition group-hover:bg-amber-100">
          <span class="material-symbols-outlined text-[26px] text-amber-700">gavel</span>
        </div>
        <div>
          <p class="text-base font-bold text-[#000666]">Conduct</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-500">Report incidents, violations, or matters requiring review.</p>
        </div>
      </button>
    </div>
  </div>

  <%# ── Step 2: Hierarchical category picker ──────────────────────────────── %>
  <div data-raise-wizard-target="step2" class="hidden">
    <div class="mb-6">
      <div class="flex items-center gap-3">
        <button type="button"
                data-raise-wizard-target="pickerBack"
                data-action="click->raise-wizard#pickerBack"
                class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition hover:bg-slate-200">
          <%= material_icon "arrow_back", classes: "material-symbols-outlined text-base" %>
        </button>
        <div class="flex-1 text-center">
          <h1 data-raise-wizard-target="pickerTitle" class="text-2xl font-bold text-[#000666]">Choose a division</h1>
          <p data-raise-wizard-target="pickerSubtitle" class="mt-1 text-sm text-slate-500">Select the division that best fits your request.</p>
        </div>
        <div class="h-8 w-8 flex-shrink-0" aria-hidden="true"></div>
      </div>

      <nav data-raise-wizard-target="pickerBreadcrumb"
           class="mt-4 flex flex-wrap items-center justify-center gap-1 text-xs"
           aria-label="Category selection progress">
      </nav>
    </div>

    <div data-raise-wizard-target="pickerCards" class="grid grid-cols-1 gap-3 sm:grid-cols-2"></div>

    <p class="mt-6 text-center text-xs text-slate-400">Tap a card to drill down — your final category choice opens the details form.</p>
  </div>

  <%# ── Step 3: Details & Proof ─────────────────────────────────────────── %>
  <div data-raise-wizard-target="step3" class="hidden">
    <div class="mb-6 flex items-center gap-3">
      <button type="button"
              data-action="click->raise-wizard#back"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition hover:bg-slate-200">
        <%= material_icon "arrow_back", classes: "material-symbols-outlined text-base" %>
      </button>
      <div>
        <h1 class="text-xl font-bold text-[#000666]">Details & Proof</h1>
        <p class="text-xs text-slate-500">Fill in the details and attach your proof.</p>
      </div>
    </div>

    <div class="clay-card p-6 sm:p-8">
      <%= form_with model: @achievement_request, url: student_achievement_requests_path, class: "space-y-5" do |f| %>
        <%= render "admin/shared/error_messages", record: @achievement_request %>

        <%# Selected category summary (shown once a category is chosen) %>
        <div data-raise-wizard-target="categorySummary"
             class="<%= category_chosen ? "" : "hidden" %> rounded-xl border border-[#000666]/10 bg-[#000666]/5 p-4">
          <p class="mb-2.5 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Selected category</p>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 space-y-0.5 text-sm">
              <p class="font-bold text-[#000666]" data-raise-wizard-target="summaryCategory">
                <%= selected_category&.name %>
              </p>
              <p class="text-xs text-slate-500">
                <span data-raise-wizard-target="summaryDivision"><%= selected_division&.name %></span>
                <span class="text-slate-300" aria-hidden="true"> / </span>
                <span data-raise-wizard-target="summarySubDivision"><%= selected_sub_division&.name %></span>
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap items-center gap-1.5">
              <% if selected_division %>
                <% badge_positive = selected_division.positive? %>
                <span data-raise-wizard-target="summaryBadge"
                      class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider ring-1 ring-inset whitespace-nowrap <%= badge_positive ? "bg-emerald-50 text-emerald-700 ring-emerald-200/70" : "bg-amber-50 text-amber-800 ring-amber-200/70" %>">
                  <%= badge_positive ? "Achievement" : "Conduct" %>
                </span>
              <% else %>
                <span data-raise-wizard-target="summaryBadge" class="hidden"></span>
              <% end %>
              <% if selected_category && selected_division %>
                <% pts = selected_category.points %>
                <% badge_positive = selected_division.positive? %>
                <span data-raise-wizard-target="summaryPoints"
                      class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ring-1 ring-inset whitespace-nowrap tabular-nums <%= badge_positive ? "bg-emerald-50 text-emerald-700 ring-emerald-200/70" : "bg-red-50 text-red-700 ring-red-200/70" %>">
                  <%= badge_positive ? "+#{pts}" : "-#{pts}" %> pts
                </span>
              <% else %>
                <span data-raise-wizard-target="summaryPoints" class="hidden"></span>
              <% end %>
            </div>
          </div>
        </div>

        <%= f.hidden_field :category_id, data: { raise_wizard_target: "categoryIdField" } %>

        <div>
          <%= f.label :title, class: admin_label_classes %>
          <%= f.text_field :title, class: admin_input_classes, placeholder: "e.g. State chess champion" %>
        </div>

        <div>
          <%= f.label :description, class: admin_label_classes %>
          <%= f.text_area :description, rows: 4, class: admin_input_classes, placeholder: "Brief description of the achievement or incident…" %>
        </div>

        <div data-controller="proof-preview">
          <%= f.label :proofs, "Proof (PNG, max 5 MB each)", class: admin_label_classes %>
          <%= f.file_field :proofs, multiple: true, accept: "image/png",
                class: "mt-1 block w-full text-sm text-slate-600 file:mr-3 file:cursor-pointer file:rounded-xl file:border-0 file:bg-[#e0e0ff] file:px-3 file:py-2 file:text-sm file:font-semibold file:text-[#000666] hover:file:bg-[#dbe1ff]",
                data: { proof_preview_target: "input", action: "change->proof-preview#preview" } %>
          <p class="mt-1 text-xs text-slate-500">Attach at least one PNG image as proof.</p>
          <div data-proof-preview-target="list" class="mt-3 flex flex-wrap gap-3"></div>
        </div>

        <div class="flex flex-wrap items-center gap-4 pt-1">
          <%= f.submit "Submit Request", class: "scats-primary-button" %>
          <%= link_to "Cancel", student_root_path, class: admin_link_classes %>
        </div>
      <% end %>
    </div>
  </div>

</div>
