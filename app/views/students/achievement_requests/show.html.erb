<div class="mx-auto w-full max-w-3xl">
  <div class="mb-6">
    <%= link_to "← Back to dashboard", student_root_path, class: admin_back_link_classes %>
  </div>

  <% if @achievement_request.supervisor_reverted? %>
    <div class="mb-6 rounded-lg border border-orange-200 bg-orange-50 p-4 text-sm text-orange-800">
      <p class="font-semibold">This request was reverted by your supervisor.</p>
      <% if (revert = @histories.select { |h| h.action == "supervisor_revert" }.last) %>
        <p class="mt-1"><%= revert.comment %></p>
      <% end %>
      <%= link_to "Edit & resubmit", edit_student_achievement_request_path(@achievement_request),
            class: "mt-2 inline-block font-semibold text-orange-900 underline hover:text-orange-700" %>
    </div>
  <% end %>

  <div class="rounded-xl bg-white p-8 shadow-md ring-1 ring-slate-200">
    <%= render "shared/achievement_request_details",
          achievement_request: @achievement_request, histories: @histories %>
  </div>
</div>
