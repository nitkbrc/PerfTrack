<%# Locals: requests, empty_message %>
<% if requests.any? %>
  <ul class="space-y-3">
    <% requests.each do |request| %>
      <li class="clay-card p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to request.title, student_achievement_request_path(request),
                    class: "font-medium text-text-main hover:text-primary hover:underline" %>
              <% if request.raised_on_behalf? %>
                <span class="scats-badge scats-badge-info text-[10px]">Raised on your behalf</span>
              <% end %>
            </div>
            <p class="mt-1 text-xs text-text-muted"><%= request.display_catalog_path %></p>
          </div>
          <% if request.approved? && request.points_awarded.present? %>
            <% if request.points_awarded.positive? %>
              <span class="scats-badge scats-badge-success shrink-0">+<%= request.points_awarded %> pts</span>
            <% else %>
              <span class="scats-badge scats-badge-danger shrink-0"><%= request.points_awarded %> pts</span>
            <% end %>
          <% else %>
            <span class="text-xs font-medium text-text-muted shrink-0">—</span>
          <% end %>
        </div>
        <p class="mt-2 text-xs text-text-muted">
          <%= request.approved? ? "Accepted" : "Rejected" %>
          <%= request.updated_at.strftime("%d %b %Y") %>
        </p>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="clay-card p-6 text-center text-sm text-text-muted">
    <%= empty_message %>
  </div>
<% end %>
