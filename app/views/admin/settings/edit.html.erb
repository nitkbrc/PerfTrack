<h1 class="mb-6 text-2xl font-bold text-text-main">Settings</h1>

<%= form_with url: admin_settings_path, method: :put, class: "space-y-8" do %>
  <div class="clay-card mx-auto max-w-lg p-6 sm:p-8">
    <%= fields_for :setting, @setting do |f| %>
      <%= render "admin/shared/error_messages", record: @setting %>

      <div class="space-y-2">
        <%= f.label :score_scale_k, "Score scale constant (k)", class: admin_label_classes %>
        <%= f.number_field :score_scale_k, min: 1, class: "#{admin_input_classes} mt-0" %>
        <div class="scats-callout scats-callout-warning mt-3" role="note">
          <span class="scats-callout-icon material-symbols-outlined" aria-hidden="true">warning</span>
          <div class="scats-callout-body">
            <p class="scats-callout-title">Read before changing</p>
            <p class="mt-1 leading-relaxed opacity-90">
              Controls how steeply net points map to the 0–10 overall score. Smaller values
              make scores react faster to points. Changing it immediately rescales every
              student's displayed score — stored point history is never affected.
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="clay-card mx-auto max-w-3xl p-6 sm:p-8">
    <h2 class="text-lg font-semibold text-text-main">Profile edit permissions</h2>
    <p class="mt-1 text-sm text-text-muted">
      Toggle which fields students and faculty may edit on their own profile. Admins are never gated.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-border-subtle text-xs uppercase tracking-wide text-text-muted">
            <th class="px-3 py-2 font-semibold">Action</th>
            <th class="px-3 py-2 font-semibold">Student</th>
            <th class="px-3 py-2 font-semibold">Faculty</th>
          </tr>
        </thead>
        <tbody>
          <% @permissions_by_action.each do |action, permissions| %>
            <tr class="border-b border-border-subtle/70">
              <td class="px-3 py-3 font-medium text-text-main"><%= action.humanize %></td>
              <% %w[student faculty].each do |role| %>
                <% permission = permissions.find { |p| p.role == role } %>
                <td class="px-3 py-3">
                  <% if permission %>
                    <label class="inline-flex items-center gap-2">
                      <%= hidden_field_tag "permissions[#{permission.id}][enabled]", "0" %>
                      <%= check_box_tag "permissions[#{permission.id}][enabled]", "1", permission.enabled?,
                            class: "rounded border-border-subtle text-primary focus:ring-secondary-container/40" %>
                      <span class="text-text-muted"><%= permission.enabled? ? "On" : "Off" %></span>
                    </label>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mx-auto max-w-3xl">
    <%= submit_tag "Save settings", class: admin_primary_button_classes %>
  </div>
<% end %>
