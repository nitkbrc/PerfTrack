<div class="mx-auto w-full max-w-5xl space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-text-main">Settings</h1>
    <p class="mt-1 text-sm text-text-muted">
      Configure review workflow, profile permissions, and scoring.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% settings_hub_cards.each do |card| %>
      <%= link_to card[:path], class: "clay-card group flex flex-col gap-3 rounded-2xl p-5 transition hover:-translate-y-0.5 hover:ring-1 hover:ring-primary/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" do %>
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-700 transition group-hover:bg-primary/10 group-hover:text-primary">
          <span class="material-symbols-outlined text-xl" aria-hidden="true"><%= card[:icon] %></span>
        </span>
        <div>
          <h2 class="text-base font-semibold text-text-main"><%= card[:title] %></h2>
          <p class="mt-1 text-sm leading-relaxed text-text-muted"><%= card[:description] %></p>
        </div>
        <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-primary">
          Open
          <span class="material-symbols-outlined text-base transition group-hover:translate-x-0.5" aria-hidden="true">arrow_forward</span>
        </span>
      <% end %>
    <% end %>
  </div>
</div>
