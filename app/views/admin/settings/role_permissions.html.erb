<div class="mx-auto w-full max-w-5xl space-y-8 pb-28"
     data-controller="unsaved-changes">
  <%= form_with url: admin_settings_path, method: :put, class: "space-y-8" do %>
    <%= hidden_field_tag :form, "role_permissions" %>

    <header class="space-y-4">
      <%= link_to edit_admin_settings_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-primary" do %>
        <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
        Settings
      <% end %>

      <div class="min-w-0 max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
            <span class="material-symbols-outlined text-[22px]" aria-hidden="true">manage_accounts</span>
          </span>
          <div>
            <h1 class="text-[26px] font-semibold leading-tight tracking-tight text-slate-900">Role permissions</h1>
            <p class="mt-1 text-sm text-slate-500">Profile self-edit fields and which review roles may add students</p>
          </div>
        </div>
      </div>
    </header>

    <% student_summary = profile_permission_summary(@permissions_by_role["student"] || []) %>
    <% faculty_summary = profile_permission_summary(@permissions_by_role["faculty"] || []) %>
    <% create_enabled = @review_roles.count(&:can_create_students?) %>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="clay-card flex items-center gap-3 px-4 py-3.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-teal-50 text-teal-700">
          <span class="material-symbols-outlined text-lg" aria-hidden="true">school</span>
        </span>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Students</p>
          <p class="text-sm font-semibold text-slate-900"><%= student_summary[:enabled] %> of <%= student_summary[:total] %> editable</p>
        </div>
      </div>
      <div class="clay-card flex items-center gap-3 px-4 py-3.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
          <span class="material-symbols-outlined text-lg" aria-hidden="true">person</span>
        </span>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Faculty</p>
          <p class="text-sm font-semibold text-slate-900"><%= faculty_summary[:enabled] %> of <%= faculty_summary[:total] %> editable</p>
        </div>
      </div>
      <div class="clay-card flex items-center gap-3 px-4 py-3.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700">
          <span class="material-symbols-outlined text-lg" aria-hidden="true">person_add</span>
        </span>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Add students</p>
          <p class="text-sm font-semibold text-slate-900"><%= create_enabled %> of <%= @review_roles.size %> review roles</p>
        </div>
      </div>
      <div class="clay-card flex items-center gap-3 px-4 py-3.5">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
          <span class="material-symbols-outlined text-lg" aria-hidden="true">admin_panel_settings</span>
        </span>
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Admins</p>
          <p class="text-sm font-semibold text-slate-900">Always full access</p>
        </div>
      </div>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Profile self-edit</h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <% %w[student faculty].each do |role| %>
          <% permissions = @permissions_by_role[role] %>
          <% next if permissions.blank? %>
          <%= render "role_permissions_panel", role: role, permissions: permissions %>
        <% end %>
      </div>
    </div>

    <section class="clay-card overflow-hidden ring-1 ring-indigo-100" aria-labelledby="add-students-permissions-heading">
      <div class="border-b border-border-subtle/60 bg-gradient-to-b from-indigo-50 to-white px-5 py-4 sm:px-6">
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700">
              <span class="material-symbols-outlined text-[22px]" aria-hidden="true">person_add</span>
            </span>
            <div class="min-w-0">
              <h2 id="add-students-permissions-heading" class="text-base font-semibold text-slate-900">
                Who can add students
              </h2>
              <p class="mt-0.5 text-xs leading-relaxed text-slate-500">
                Faculty holding an enabled review role may create students manually or via CSV.
                Unassigned faculty cannot add students.
              </p>
            </div>
          </div>
          <div class="shrink-0 text-right">
            <p class="text-lg font-semibold tabular-nums text-indigo-700">
              <%= create_enabled %>/<%= @review_roles.size %>
            </p>
            <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">Enabled</p>
          </div>
        </div>
      </div>

      <% if @review_roles.any? %>
        <ul class="divide-y divide-border-subtle/60">
          <% @review_roles.each do |review_role| %>
            <li>
              <div class="flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50/60 sm:px-6">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                  <span class="material-symbols-outlined text-[18px]" aria-hidden="true">badge</span>
                </span>

                <div class="min-w-0 flex-1">
                  <p class="font-medium text-slate-900"><%= review_role.name %></p>
                  <p class="mt-0.5 text-xs leading-relaxed text-slate-400">
                    <%= review_role.scope_division? ? "Division-scoped" : "Sub-division-scoped" %>
                    <% if review_role.system_role? %> · System role<% end %>
                  </p>
                </div>

                <div class="shrink-0"
                     data-controller="switch-status"
                     data-switch-status-on-value="Allowed"
                     data-switch-status-off-value="Blocked">
                  <%= hidden_field_tag "review_roles[#{review_role.id}][can_create_students]", "0" %>
                  <label class="inline-flex cursor-pointer flex-col items-end gap-1.5 sm:flex-row sm:items-center sm:gap-3">
                    <%= check_box_tag "review_roles[#{review_role.id}][can_create_students]", "1", review_role.can_create_students?,
                          class: "peer sr-only",
                          data: {
                            switch_status_target: "input",
                            action: "change->switch-status#sync"
                          },
                          aria: { label: "#{review_role.name} may add students" } %>
                    <span class="relative h-6 w-11 shrink-0 rounded-full bg-slate-200 transition peer-checked:bg-primary peer-focus-visible:ring-2 peer-focus-visible:ring-secondary-container/50 peer-focus-visible:ring-offset-1 after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5"
                          aria-hidden="true"></span>
                    <span class="inline-flex min-w-[4.5rem] items-center justify-end gap-1 text-xs font-semibold <%= review_role.can_create_students? ? "text-emerald-700" : "text-slate-400" %>"
                          data-switch-status-target="status">
                      <% if review_role.can_create_students? %>
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                      <% end %>
                      <%= review_role.can_create_students? ? "Allowed" : "Blocked" %>
                    </span>
                  </label>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-6 text-sm text-slate-500 sm:px-6">No review roles defined yet.</p>
      <% end %>
    </section>
  <% end %>

  <%= render "shared/unsaved_changes_bar",
        hint: "Permission changes apply after you save.",
        discard_path: role_permissions_admin_settings_path,
        save_action: "click->unsaved-changes#save",
        save_label: "Save permissions" %>
</div>
