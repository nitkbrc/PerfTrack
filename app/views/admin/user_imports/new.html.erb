<div class="mx-auto max-w-lg">
  <h1 class="mb-2 text-2xl font-bold text-slate-900">Import users from CSV</h1>
  <p class="mb-6 text-sm text-slate-500">
    Upload a CSV with the columns <code class="rounded bg-slate-100 px-1 py-0.5 text-xs">name, email, role, usn, department, sem</code>.
    The last three columns only apply to students. Each user must change their temporary password on first login.
  </p>

  <div class="rounded-xl bg-white p-8 shadow-md ring-1 ring-slate-200">
    <ul class="mb-6 list-disc space-y-1 pl-5 text-sm text-slate-600">
      <li>Students' temporary password is their USN typed twice.</li>
      <li>Faculty and admin passwords come from the field below, or are auto-generated (shown once in the import results) when it is left blank.</li>
      <li><code>role</code> must be admin, faculty or student.</li>
      <li>
        <code>department</code> must match an existing department name exactly:
        <span class="font-semibold"><%= Department.order(:name).pluck(:name).join(", ").presence || "none created yet — add departments first" %></span>
      </li>
      <li>Rows with errors are skipped — everything else still imports.</li>
    </ul>

    <%# turbo: false — the results page is a rendered (non-redirect) response,
        which Turbo would silently discard on a form submission. %>
    <%= form_with url: admin_user_imports_path, multipart: true, data: { turbo: false }, class: "space-y-5" do %>
      <div>
        <%= label_tag :file, "CSV file", class: admin_label_classes %>
        <%= file_field_tag :file, accept: ".csv,text/csv",
              class: "mt-1 block w-full text-sm text-slate-600 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-600 hover:file:bg-indigo-100" %>
      </div>

      <div>
        <%= label_tag :staff_password, "Temporary password for faculty & admin (optional)", class: admin_label_classes %>
        <%= text_field_tag :staff_password, nil, class: admin_input_classes,
              placeholder: "Leave blank to auto-generate", autocomplete: "off" %>
        <p class="mt-1 text-xs text-slate-500">
          Used for every faculty/admin row in this file (min 6 characters). Students always get their USN typed twice.
          Everyone must change their password on first login.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <%= submit_tag "Import users", class: admin_primary_button_classes %>
        <%= link_to "Download template", template_admin_user_imports_path, class: admin_link_classes %>
        <%= link_to "Cancel", admin_users_path, class: admin_link_classes %>
      </div>
    <% end %>
  </div>
</div>
