<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-bold text-text-main">Departments</h1>
  <%= link_to new_admin_department_path, class: "#{admin_primary_button_classes} inline-flex items-center gap-1.5" do %>
    <span class="material-symbols-outlined text-base leading-none" aria-hidden="true">add</span>
    New department
  <% end %>
</div>

<% if @departments.any? %>
  <div class="clay-card scats-list-shell">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="w-28 whitespace-nowrap px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="scats-list">
        <% @departments.each do |department| %>
          <tr class="scats-row relative cursor-pointer">
            <td class="min-w-0 px-4 py-3 font-medium text-text-main">
              <%= link_to edit_admin_department_path(department),
                    class: "scats-row-hit",
                    aria: { label: "Edit #{department.name}" } do %>
              <% end %>
              <span class="pointer-events-none relative z-10 block truncate"><%= department.name %></span>
            </td>
            <td class="scats-row-actions px-4 py-3 text-right">
              <%= button_to "Delete", admin_department_path(department), method: :delete,
                    data: { turbo_confirm: "Delete #{department.name}?" },
                    form: { class: "inline", onclick: "event.stopPropagation()" },
                    class: admin_delete_classes %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="clay-card p-8 text-center text-sm text-text-muted">
    No departments yet. Create the first one.
  </div>
<% end %>
