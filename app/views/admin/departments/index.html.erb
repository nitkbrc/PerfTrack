<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900">Departments</h1>
  <%= link_to "New department", new_admin_department_path, class: admin_primary_button_classes %>
</div>

<% if @departments.any? %>
  <div class="overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @departments.each do |department| %>
          <tr>
            <td class="px-4 py-3 font-medium text-slate-900"><%= department.name %></td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex items-center gap-4">
                <%= link_to "Edit", edit_admin_department_path(department), class: admin_link_classes %>
                <%= button_to "Delete", admin_department_path(department), method: :delete,
                      data: { turbo_confirm: "Delete #{department.name}?" }, class: admin_delete_classes %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-500 shadow-md ring-1 ring-slate-200">
    No departments yet. Create the first one.
  </p>
<% end %>
