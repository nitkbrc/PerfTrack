<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900">Departments</h1>
  <%= link_to "New department", new_admin_department_path, class: admin_primary_button_classes %>
</div>

<% if @departments.any? %>
  <div class="clay-card scats-list-shell">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="w-20 whitespace-nowrap px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="scats-list divide-y divide-slate-100">
        <% @departments.each do |department| %>
          <tr class="relative cursor-pointer">
            <td class="min-w-0 px-4 py-3 font-medium text-slate-900">
              <%= link_to edit_admin_department_path(department),
                    class: "absolute inset-0 z-0",
                    aria: { label: "Edit #{department.name}" } do %>
              <% end %>
              <span class="pointer-events-none relative z-10 block truncate"><%= department.name %></span>
            </td>
            <td class="relative z-10 whitespace-nowrap px-4 py-3 text-right">
              <%= button_to "Delete", admin_department_path(department), method: :delete,
                    data: { turbo_confirm: "Delete #{department.name}?" },
                    form: { class: "inline", onclick: "event.stopPropagation()" },
                    class: admin_delete_classes %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-500 shadow-md ring-1 ring-slate-200">
    No departments yet. Create the first one.
  </p>
<% end %>
