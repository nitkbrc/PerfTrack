<% owner_name = @owner.name %>
<% steps_path = @owner_type == :division ? admin_division_hierarchy_steps_path(@owner) : admin_sub_division_hierarchy_steps_path(@owner) %>
<% owner_path = @owner_type == :division ? admin_division_path(@owner) : admin_sub_division_path(@owner) %>
<% scope_label = @owner_type == :division ? "Division" : "Sub-division" %>

<div class="mx-auto w-full max-w-4xl space-y-6">
  <header>
    <nav class="flex flex-wrap items-center gap-1.5 text-sm text-text-muted" aria-label="Breadcrumb">
      <%= link_to "Settings", edit_admin_settings_path, class: admin_link_classes %>
      <span class="text-slate-300" aria-hidden="true">/</span>
      <%= link_to "Hierarchies", admin_hierarchies_path, class: admin_link_classes %>
      <span class="text-slate-300" aria-hidden="true">/</span>
      <span class="font-medium text-text-main"><%= owner_name %></span>
    </nav>

    <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400"><%= scope_label %> chain</p>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-text-main"><%= owner_name %></h1>
        <p class="mt-1 text-sm text-text-muted">
          Order review roles for this <%= scope_label.downcase %> only.
          <%= link_to "View catalog page", owner_path, class: admin_link_classes %>.
        </p>
      </div>
      <% if @steps.any? %>
        <p class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-600">
          <%= hierarchy_chain_summary(@steps) %>
        </p>
      <% end %>
    </div>
  </header>

  <section class="clay-card overflow-hidden">
    <div class="border-b border-border-subtle/70 px-5 py-4 sm:px-6">
      <h2 class="text-base font-semibold text-text-main">Review steps</h2>
      <p class="mt-0.5 text-sm text-text-muted">
        Any <%= scope_label.downcase %>-scoped role works. Requests advance top to bottom.
        If Supervisor is included it stays first; if Dean is included it stays last.
        Unassigned steps are skipped at runtime. At least one step is required.
      </p>
    </div>

    <% if @steps.empty? %>
      <div class="px-5 py-10 text-center sm:px-6">
        <span class="material-symbols-outlined text-3xl text-slate-300" aria-hidden="true">linear_scale</span>
        <p class="mt-2 text-sm font-medium text-text-main">No steps yet</p>
        <p class="mt-1 text-sm text-text-muted">Add a review role below to build this chain.</p>
      </div>
    <% else %>
      <ol class="divide-y divide-border-subtle/60">
        <% @steps.each_with_index do |step, index| %>
          <% assignee = step.assigned_user %>
          <li class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="flex min-w-0 items-start gap-3">
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-bold text-slate-700 ring-1 ring-slate-200/80">
                <%= step.position %>
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <p class="font-semibold text-text-main"><%= step.review_role.name %></p>
                  <% if step.can_raise_on_behalf? %>
                    <span class="scats-badge scats-badge-warning">Raise on behalf</span>
                  <% end %>
                  <% if step.supervisor_anchor? %>
                    <span class="scats-badge scats-badge-info">Anchor · first</span>
                  <% elsif step.dean_anchor? %>
                    <span class="scats-badge scats-badge-neutral">Anchor · last</span>
                  <% elsif index.zero? %>
                    <span class="scats-badge scats-badge-info">First</span>
                  <% elsif index == @steps.size - 1 %>
                    <span class="scats-badge scats-badge-neutral">Final</span>
                  <% end %>
                </div>
                <p class="mt-1 text-sm text-text-muted">
                  <% if assignee %>
                    Assigned to <span class="font-medium text-text-main"><%= assignee.name.presence || assignee.email %></span>
                  <% else %>
                    <span class="text-amber-700">No assignee — this step will be skipped</span>
                  <% end %>
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 sm:justify-end">
              <% if step.review_role.raiseable_on_behalf_eligible? %>
                <%= form_with model: step,
                      url: (@owner_type == :division ? admin_division_hierarchy_step_path(@owner, step) : admin_sub_division_hierarchy_step_path(@owner, step)),
                      method: :patch,
                      class: "flex items-center gap-2 rounded-lg border border-border-subtle bg-slate-50 px-2.5 py-1.5" do |f| %>
                  <%= f.check_box :can_raise_on_behalf, class: "rounded border-slate-300 text-primary focus:ring-secondary-container/40" %>
                  <%= f.label :can_raise_on_behalf, "Raiseable", class: "text-xs font-medium text-text-main" %>
                  <%= f.submit "Save", class: "cursor-pointer text-xs font-semibold text-primary hover:text-secondary" %>
                <% end %>
              <% end %>

              <div class="inline-flex overflow-hidden rounded-md border border-border-subtle bg-white shadow-sm">
                <% can_move_up = index.positive? && !step.supervisor_anchor? && !step.dean_anchor? %>
                <% can_move_down = index < @steps.size - 1 && !step.supervisor_anchor? && !step.dean_anchor? %>
                <% if can_move_up %>
                  <%= button_to (@owner_type == :division ? move_up_admin_division_hierarchy_step_path(@owner, step) : move_up_admin_sub_division_hierarchy_step_path(@owner, step)),
                        method: :patch,
                        class: "inline-flex h-9 w-9 cursor-pointer items-center justify-center text-slate-600 transition hover:bg-slate-50",
                        title: "Move up",
                        form: { class: "inline" } do %>
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_upward</span>
                    <span class="sr-only">Move up</span>
                  <% end %>
                <% else %>
                  <span class="inline-flex h-9 w-9 items-center justify-center text-slate-300" aria-hidden="true"
                        title="<%= step.supervisor_anchor? || step.dean_anchor? ? 'Anchored role' : 'Already first' %>">
                    <span class="material-symbols-outlined text-lg">arrow_upward</span>
                  </span>
                <% end %>

                <% if can_move_down %>
                  <%= button_to (@owner_type == :division ? move_down_admin_division_hierarchy_step_path(@owner, step) : move_down_admin_sub_division_hierarchy_step_path(@owner, step)),
                        method: :patch,
                        class: "inline-flex h-9 w-9 cursor-pointer items-center justify-center border-l border-border-subtle text-slate-600 transition hover:bg-slate-50",
                        title: "Move down",
                        form: { class: "inline" } do %>
                    <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_downward</span>
                    <span class="sr-only">Move down</span>
                  <% end %>
                <% else %>
                  <span class="inline-flex h-9 w-9 items-center justify-center border-l border-border-subtle text-slate-300" aria-hidden="true"
                        title="<%= step.supervisor_anchor? || step.dean_anchor? ? 'Anchored role' : 'Already last' %>">
                    <span class="material-symbols-outlined text-lg">arrow_downward</span>
                  </span>
                <% end %>
              </div>

              <% if @steps.size > 1 %>
                <%= button_to "Remove",
                      (@owner_type == :division ? admin_division_hierarchy_step_path(@owner, step) : admin_sub_division_hierarchy_step_path(@owner, step)),
                      method: :delete,
                      form: { data: { turbo_confirm: "Remove this step from the chain?" } },
                      class: admin_delete_classes %>
              <% else %>
                <span class="text-xs text-text-muted" title="At least one step is required">Last step</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if @available_roles.any? %>
      <div class="border-t border-border-subtle/70 bg-slate-50/40 px-5 py-4 sm:px-6">
        <%= form_with url: steps_path, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |f| %>
          <div class="min-w-0 flex-1">
            <label class="<%= admin_label_classes %>">Add role to chain</label>
            <%= select_tag "hierarchy_step[review_role_id]",
                  options_from_collection_for_select(@available_roles, :id, :name),
                  class: admin_input_classes %>
          </div>
          <%= f.submit "Add step", class: "#{admin_primary_button_classes} shrink-0" %>
        <% end %>
      </div>
    <% else %>
      <div class="border-t border-border-subtle/70 px-5 py-3 text-sm text-text-muted sm:px-6">
        All roles for this scope are already in the chain.
        <%= link_to "Manage review roles", admin_review_roles_path, class: admin_link_classes %>
        if you need a new one.
      </div>
    <% end %>
  </section>

  <% targets = @owner_type == :division ? Division.active.where.not(id: @owner.id).order(:name) : SubDivision.active.where.not(id: @owner.id).includes(:division).order(:name) %>
  <section class="clay-card overflow-hidden">
    <div class="border-b border-border-subtle/70 px-5 py-4 sm:px-6">
      <h2 class="text-base font-semibold text-text-main">Bulk-apply</h2>
      <p class="mt-0.5 text-sm text-text-muted">
        Copy this chain onto other <%= @owner_type == :division ? "divisions" : "sub-divisions" %> as independent lists (not a shared template).
      </p>
    </div>

    <% if targets.empty? %>
      <p class="px-5 py-6 text-sm text-text-muted sm:px-6">No other targets available.</p>
    <% else %>
      <%= form_with url: (@owner_type == :division ? bulk_apply_admin_division_hierarchy_steps_path(@owner) : bulk_apply_admin_sub_division_hierarchy_steps_path(@owner)),
            method: :post, class: "px-5 py-4 sm:px-6" do %>
        <div class="grid gap-2 sm:grid-cols-2">
          <% targets.each do |target| %>
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-transparent px-2 py-2 text-sm transition hover:border-border-subtle hover:bg-slate-50">
              <%= check_box_tag "target_ids[]", target.id, false, class: "rounded border-slate-300 text-primary focus:ring-secondary-container/40" %>
              <span class="min-w-0">
                <span class="font-medium text-text-main"><%= target.name %></span>
                <% if @owner_type == :sub_division && target.respond_to?(:division) %>
                  <span class="block truncate text-xs text-text-muted"><%= target.division.name %></span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
        <div class="mt-4">
          <%= submit_tag "Apply to selected",
                class: admin_primary_button_classes,
                data: { turbo_confirm: "Overwrite hierarchies on the selected targets?" } %>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
