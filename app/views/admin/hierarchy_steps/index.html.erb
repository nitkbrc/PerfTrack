<% owner_name = @owner.name %>
<% steps_path = @owner_type == :division ? admin_division_hierarchy_steps_path(@owner) : admin_sub_division_hierarchy_steps_path(@owner) %>

<div class="mb-6">
  <% if @owner_type == :division %>
    <%= link_to "← Back to #{owner_name}", admin_division_path(@owner), class: admin_back_link_classes %>
  <% else %>
    <%= link_to "← Back to #{owner_name}", admin_sub_division_path(@owner), class: admin_back_link_classes %>
  <% end %>
  <h1 class="mt-3 text-2xl font-bold text-text-main">Review hierarchy — <%= owner_name %></h1>
  <p class="mt-1 text-sm text-text-muted">Ordered steps for this <%= @owner_type.to_s.humanize.downcase %> only.</p>
</div>

<div class="clay-card mb-6 p-5">
  <ol class="space-y-3">
    <% @steps.each do |step| %>
      <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-border-subtle px-4 py-3">
        <div>
          <span class="mr-2 text-xs font-semibold text-text-muted">#<%= step.position %></span>
          <span class="font-medium text-text-main"><%= step.review_role.name %></span>
          <% if step.can_raise_on_behalf? %>
            <span class="scats-badge scats-badge-warning ml-2">Can raise on behalf</span>
          <% end %>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <% if step.review_role.raiseable_on_behalf_eligible? %>
            <%= form_with model: step,
                  url: (@owner_type == :division ? admin_division_hierarchy_step_path(@owner, step) : admin_sub_division_hierarchy_step_path(@owner, step)),
                  method: :patch, class: "flex items-center gap-2" do |f| %>
              <%= f.check_box :can_raise_on_behalf %>
              <%= f.label :can_raise_on_behalf, "Raiseable", class: "text-xs" %>
              <%= f.submit "Save", class: "scats-secondary-button px-2 py-1 text-xs" %>
            <% end %>
          <% end %>
          <%= button_to "↑", (@owner_type == :division ? move_up_admin_division_hierarchy_step_path(@owner, step) : move_up_admin_sub_division_hierarchy_step_path(@owner, step)), method: :patch, class: admin_secondary_button_classes %>
          <%= button_to "↓", (@owner_type == :division ? move_down_admin_division_hierarchy_step_path(@owner, step) : move_down_admin_sub_division_hierarchy_step_path(@owner, step)), method: :patch, class: admin_secondary_button_classes %>
          <%= button_to "Remove", (@owner_type == :division ? admin_division_hierarchy_step_path(@owner, step) : admin_sub_division_hierarchy_step_path(@owner, step)),
                method: :delete, form: { data: { turbo_confirm: "Remove this step?" } }, class: admin_delete_classes %>
        </div>
      </li>
    <% end %>
  </ol>

  <% if @available_roles.any? %>
    <%= form_with url: steps_path, class: "mt-5 flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <label class="<%= admin_label_classes %>">Add role step</label>
        <%= select_tag "hierarchy_step[review_role_id]",
              options_from_collection_for_select(@available_roles, :id, :name),
              class: admin_input_classes %>
      </div>
      <%= f.submit "Add step", class: admin_primary_button_classes %>
    <% end %>
  <% end %>
</div>

<div class="clay-card p-5">
  <h2 class="mb-2 text-lg font-semibold">Bulk-apply this hierarchy</h2>
  <p class="mb-3 text-sm text-text-muted">Copies these steps as independent lists onto the selected targets.</p>
  <%= form_with url: (@owner_type == :division ? bulk_apply_admin_division_hierarchy_steps_path(@owner) : bulk_apply_admin_sub_division_hierarchy_steps_path(@owner)),
        method: :post, class: "space-y-3" do %>
    <% targets = @owner_type == :division ? Division.active.where.not(id: @owner.id).order(:name) : SubDivision.active.where.not(id: @owner.id).order(:name) %>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% targets.each do |target| %>
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag "target_ids[]", target.id %>
          <%= target.name %>
        </label>
      <% end %>
    </div>
    <%= submit_tag "Apply to selected", class: admin_primary_button_classes, data: { turbo_confirm: "Overwrite hierarchies on selected targets?" } %>
  <% end %>
</div>
