<div class="mb-6 flex items-center justify-between">
  <div><%= link_to "? Back to #{@sub_division.division.name}", admin_division_path(@sub_division.division), class: admin_back_link_classes %><h1 class="mt-2 text-2xl font-bold text-slate-900"><%= @sub_division.name %></h1></div>
  <div class="flex items-center gap-4">
    <%= render "admin/shared/archived_toggle", show_archived: @show_archived, archived_count: @archived_count, active_path: admin_sub_division_path(@sub_division), archived_path: admin_sub_division_path(@sub_division, archived: 1) %>
  </div>
</div>
<div class="clay-card scats-list-shell">
  <table class="w-full text-left text-sm">
    <thead class="bg-[#1B4332]/5 text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Category</th>
        <th class="w-24 px-4 py-3">Points</th>
        <th class="w-40 whitespace-nowrap px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="scats-list divide-y divide-slate-100">
      <% @categories.each do |category| %>
        <tr class="<%= "relative cursor-pointer" unless category.archived? %>">
          <td class="min-w-0 px-4 py-3 font-medium">
            <% unless category.archived? %>
              <%= link_to edit_admin_category_path(category),
                    class: "absolute inset-0 z-0",
                    data: admin_modal_frame_data,
                    aria: { label: "Edit #{category.name}" } do %>
              <% end %>
            <% end %>
            <span class="<%= "pointer-events-none relative z-10" unless category.archived? %> block truncate">
              <%= category.name %>
              <%= archived_badge(category) if category.archived? %>
            </span>
          </td>
          <td class="<%= "pointer-events-none relative z-10" unless category.archived? %> whitespace-nowrap px-4 py-3"><%= category.points %></td>
          <td class="relative z-10 whitespace-nowrap px-4 py-3 text-right">
            <%= button_to(
                  category.archived? ? admin_restore_action_label : admin_archive_action_label,
                  category.archived? ? restore_admin_category_path(category) : archive_admin_category_path(category),
                  method: :patch,
                  form: { class: "inline", onclick: "event.stopPropagation()" },
                  class: category.archived? ? admin_secondary_button_classes : admin_warning_button_classes
                ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% unless @show_archived %>
  <%= link_to new_admin_category_path(sub_division_id: @sub_division.id),
        class: "mt-5 flex min-h-24 items-center justify-center rounded-3xl border-2 border-dashed border-[#1B4332]/25 text-4xl text-[#1B4332] transition hover:bg-white/60",
        aria: { label: "Create category" },
        data: admin_modal_frame_data do %>+<% end %>
<% end %>
