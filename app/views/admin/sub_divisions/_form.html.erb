<%= form_with model: [ :admin, sub_division ], class: "space-y-5" do |f| %>
  <%= render "admin/shared/error_messages", record: sub_division %>

  <div>
    <%= f.label :division_id, "Division", class: admin_label_classes %>
    <%= f.collection_select :division_id, Division.active.order(:name), :id, :name,
          { prompt: "Select a division" }, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :name, class: admin_label_classes %>
    <%= f.text_field :name, class: admin_input_classes %>
  </div>

  <p class="text-xs text-slate-500">
    Assign a Supervisor via
    <%= link_to "Role assignments", admin_role_assignments_path, class: admin_link_classes %>
    after creating the sub-division.
  </p>

  <div class="flex items-center gap-4">
    <%= f.submit class: admin_primary_button_classes %>
    <button type="button" data-action="modal#close" class="<%= admin_link_classes %>">Cancel</button>
  </div>
<% end %>
