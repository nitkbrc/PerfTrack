<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900"><%= @show_archived ? "Archived divisions" : "Divisions" %></h1>
  <div class="flex items-center gap-4">
    <%= render "admin/shared/archived_toggle", show_archived: @show_archived,
          archived_count: @archived_count, active_path: admin_divisions_path,
          archived_path: admin_divisions_path(archived: 1) %>
  </div>
</div>

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  <% @divisions.each do |division| %>
    <article class="clay-card p-5 <%= "relative cursor-pointer" unless division.archived? %>">
      <% unless division.archived? %>
        <%= link_to admin_division_path(division),
              class: "absolute inset-0 z-0",
              aria: { label: division.name } do %>
        <% end %>
      <% end %>
      <div class="<%= "pointer-events-none relative z-10" unless division.archived? %>">
        <span class="rounded-full px-2 py-0.5 text-xs font-semibold <%= division.positive? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>"><%= division.div_type %></span>
        <h2 class="mt-3 text-lg font-bold text-[#000666]"><%= division.name %></h2>
        <p class="mt-1 text-sm text-slate-600">Dean: <%= division.dean.name.presence || division.dean.email %></p>
        <%= archived_badge(division) if division.archived? %>
      </div>
      <div class="relative z-10 mt-5 flex flex-wrap items-center gap-2">
        <% if division.archived? %>
          <%= button_to admin_restore_action_label, restore_admin_division_path(division), method: :patch,
                form: { onclick: "event.stopPropagation()" },
                class: admin_secondary_button_classes %>
        <% else %>
          <%= link_to admin_edit_action_label, edit_admin_division_path(division), class: admin_secondary_button_classes, data: admin_modal_frame_data %>
          <%= button_to admin_archive_action_label, archive_admin_division_path(division), method: :patch,
                form: { onclick: "event.stopPropagation()" },
                class: admin_warning_button_classes %>
        <% end %>
      </div>
    </article>
  <% end %>
  <% unless @show_archived %>
    <%= link_to new_admin_division_path,
          class: "flex min-h-48 items-center justify-center rounded-3xl border-2 border-dashed border-[#000666]/25 p-5 text-4xl font-light text-[#000666] transition hover:bg-white/60",
          aria: { label: "Create division" },
          data: admin_modal_frame_data do %>+<% end %>
  <% end %>
</div>
