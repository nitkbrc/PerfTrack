<%= form_with model: [ :admin, division ], class: "space-y-5",
      data: (division.persisted? ? { controller: "unsaved-changes" } : {}) do |f| %>
  <%= render "admin/shared/error_messages", record: division %>

  <div>
    <%= f.label :name, class: admin_label_classes %>
    <%= f.text_field :name, autofocus: true, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :div_type, "Type", class: admin_label_classes %>
    <%= f.select :div_type, Division.div_types.keys.map { |t| [ t.titleize, t ] }, {}, class: admin_input_classes %>
    <p class="mt-1 text-xs text-slate-500">Positive divisions award points; negative divisions deduct them.</p>
  </div>

  <p class="text-xs text-slate-500">
    Assign a Dean via
    <%= link_to "Role assignments", admin_role_assignments_path, class: admin_link_classes %>
    after creating the division. Configure the review chain under Hierarchy on the division page.
  </p>

  <div class="flex items-center gap-4">
    <%= f.submit class: admin_primary_button_classes %>
    <button type="button" data-action="modal#close" class="<%= admin_link_classes %>">Cancel</button>
  </div>
<% end %>
