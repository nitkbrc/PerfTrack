<%= form_with model: [ :admin, category ], class: "space-y-5" do |f| %>
  <%= render "admin/shared/error_messages", record: category %>

  <div>
    <%= f.label :sub_division_id, "Sub-division", class: admin_label_classes %>
    <%= f.collection_select :sub_division_id, SubDivision.active.includes(:division).order(:name), :id,
          ->(s) { "#{s.division.name} / #{s.name}" }, { prompt: "Select a sub-division" }, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :name, class: admin_label_classes %>
    <%= f.text_field :name, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :points, class: admin_label_classes %>
    <%= f.number_field :points, min: 0, class: admin_input_classes %>
    <p class="mt-1 text-xs text-slate-500">Always a positive magnitude — the division's polarity applies the sign.</p>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit class: admin_primary_button_classes %>
    <button type="button" data-action="modal#close" class="<%= admin_link_classes %>">Cancel</button>
  </div>
<% end %>
