<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900"><%= @show_archived ? "Archived categories" : "Categories" %></h1>
  <div class="flex items-center gap-4">
    <%= render "admin/shared/archived_toggle", show_archived: @show_archived,
          archived_count: @archived_count, active_path: admin_categories_path,
          archived_path: admin_categories_path(archived: 1) %>
    <%= link_to "New category", new_admin_category_path, class: admin_primary_button_classes, data: admin_modal_frame_data %>
  </div>
</div>

<% if @categories.any? %>
  <div class="clay-card scats-list-shell">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="hidden px-4 py-3 sm:table-cell">Sub-division</th>
          <th class="hidden px-4 py-3 md:table-cell">Division</th>
          <th class="w-24 px-4 py-3">Points</th>
          <th class="w-40 whitespace-nowrap px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="scats-list divide-y divide-slate-100">
        <% @categories.each do |category| %>
          <tr class="<%= "relative cursor-pointer" unless category.archived? %>">
            <td class="min-w-0 px-4 py-3 font-medium text-slate-900">
              <% unless category.archived? %>
                <%= link_to edit_admin_category_path(category),
                      class: "absolute inset-0 z-0",
                      data: admin_modal_frame_data,
                      aria: { label: "Edit #{category.name}" } do %>
                <% end %>
              <% end %>
              <span class="<%= "pointer-events-none relative z-10" unless category.archived? %> block truncate"><%= category.name %></span>
            </td>
            <td class="<%= "pointer-events-none relative z-10" unless category.archived? %> hidden min-w-0 truncate px-4 py-3 text-slate-600 sm:table-cell"><%= category.sub_division.name %></td>
            <td class="<%= "pointer-events-none relative z-10" unless category.archived? %> hidden min-w-0 truncate px-4 py-3 text-slate-600 md:table-cell"><%= category.sub_division.division.name %></td>
            <td class="<%= "pointer-events-none relative z-10" unless category.archived? %> whitespace-nowrap px-4 py-3 font-semibold <%= category.sub_division.division.positive? ? 'text-green-700' : 'text-red-700' %>">
              <%= category.sub_division.division.positive? ? "+#{category.points}" : "-#{category.points}" %>
              <%= archived_badge(category) if category.archived? %>
            </td>
            <td class="relative z-10 whitespace-nowrap px-4 py-3 text-right">
              <div class="inline-flex items-center gap-4">
                <% if category.archived? %>
                  <%= button_to "Restore", restore_admin_category_path(category), method: :patch,
                        form: { class: "inline", onclick: "event.stopPropagation()" },
                        class: admin_link_classes %>
                  <%= button_to "Delete permanently", admin_category_path(category), method: :delete,
                        data: { turbo_confirm: "Permanently delete #{category.name}? This cannot be undone." },
                        form: { class: "inline", onclick: "event.stopPropagation()" },
                        class: admin_delete_classes %>
                <% else %>
                  <%= button_to "Archive", archive_admin_category_path(category), method: :patch,
                        data: { turbo_confirm: "Archive #{category.name}? Students and supervisors won't be able to pick it for new requests. You can restore it later." },
                        form: { class: "inline", onclick: "event.stopPropagation()" },
                        class: admin_archive_classes %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-500 shadow-md ring-1 ring-slate-200">
    <%= @show_archived ? "No archived categories." : "No categories yet. Create a sub-division first, then add point-bearing categories under it." %>
  </p>
<% end %>
