<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900">Reason templates</h1>
  <%= link_to "New template", new_admin_reason_template_path, class: admin_primary_button_classes %>
</div>

<% if @reason_templates.any? %>
  <div class="overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3">Message</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @reason_templates.each do |template| %>
          <tr>
            <td class="px-4 py-3 text-slate-700"><%= truncate(template.message_text, length: 120) %></td>
            <td class="px-4 py-3 text-right">
              <div class="inline-flex items-center gap-4">
                <%= link_to "Edit", edit_admin_reason_template_path(template), class: admin_link_classes %>
                <%= button_to "Delete", admin_reason_template_path(template), method: :delete,
                      data: { turbo_confirm: "Delete this template?" }, class: admin_delete_classes %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-500 shadow-md ring-1 ring-slate-200">
    No reason templates yet. These pre-fill revert/reject messages for supervisors and deans.
  </p>
<% end %>
