<div class="mb-6 flex items-center justify-between gap-3">
  <h1 class="text-2xl font-bold text-text-main">Reason templates</h1>
  <%= link_to new_admin_reason_template_path, class: "#{admin_primary_button_classes} inline-flex items-center gap-1.5" do %>
    <span class="material-symbols-outlined text-base leading-none" aria-hidden="true">add</span>
    New template
  <% end %>
</div>

<% if @reason_templates.any? %>
  <div class="clay-card scats-list-shell">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
        <tr>
          <th class="px-4 py-3">Message</th>
          <th class="w-20 whitespace-nowrap px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="scats-list">
        <% @reason_templates.each do |template| %>
          <tr class="scats-row relative cursor-pointer">
            <td class="min-w-0 px-4 py-3 text-text-main">
              <%= link_to edit_admin_reason_template_path(template),
                    class: "absolute inset-0 z-0",
                    aria: { label: "Edit reason template" } do %>
              <% end %>
              <span class="pointer-events-none relative z-10"><%= truncate(template.message_text, length: 120) %></span>
            </td>
            <td class="relative z-10 whitespace-nowrap px-4 py-3 text-right">
              <%= button_to "Delete", admin_reason_template_path(template), method: :delete,
                    data: { turbo_confirm: "Delete this template?" },
                    form: { class: "inline", onclick: "event.stopPropagation()" },
                    class: admin_delete_classes %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="clay-card p-8 text-center text-sm text-text-muted">
    No reason templates yet. These pre-fill revert/reject messages for supervisors and deans.
  </div>
<% end %>
