<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900">Users</h1>
  <%= link_to "New user", new_admin_user_path, class: admin_primary_button_classes %>
</div>

<div class="overflow-hidden rounded-xl bg-white shadow-md ring-1 ring-slate-200">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Role</th>
        <th class="px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3 font-medium text-slate-900">
            <%= user.name.presence || "—" %>
            <% if user == current_user %>
              <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">you</span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-slate-600"><%= user.email %></td>
          <td class="px-4 py-3">
            <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-indigo-700"><%= user.role %></span>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="inline-flex items-center gap-4">
              <%= link_to "Edit", edit_admin_user_path(user), class: admin_link_classes %>
              <% unless user == current_user %>
                <%= button_to "Delete", admin_user_path(user), method: :delete,
                      data: { turbo_confirm: "Delete #{user.email}?" }, class: admin_delete_classes %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
