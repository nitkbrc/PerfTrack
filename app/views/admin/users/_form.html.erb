<div class="mx-auto max-w-lg rounded-xl bg-white p-8 shadow-md ring-1 ring-slate-200" data-controller="role-fields">
  <%= form_with model: [ :admin, user ], class: "space-y-5" do |f| %>
    <%= render "admin/shared/error_messages", record: user %>

    <div>
      <%= f.label :name, class: admin_label_classes %>
      <%= f.text_field :name, autofocus: true, autocomplete: "off", class: admin_input_classes %>
    </div>

    <div>
      <%= f.label :email, class: admin_label_classes %>
      <%= f.email_field :email, autocomplete: "off", class: admin_input_classes %>
    </div>

    <div>
      <%= f.label :role, class: admin_label_classes %>
      <%= f.select :role, User.roles.keys.map { |r| [ r.titleize, r ] }, {},
            class: admin_input_classes,
            data: { role_fields_target: "roleSelect", action: "change->role-fields#toggle" } %>
    </div>

    <% user.build_student_profile if user.student_profile.nil? %>
    <fieldset data-role-fields-target="studentFields" <%= "hidden" unless user.student? %>
              class="space-y-5 rounded-lg border border-slate-200 p-4">
      <legend class="px-1 text-sm font-semibold text-slate-700">Student profile</legend>

      <%= f.fields_for :student_profile do |sp| %>
        <div>
          <%= sp.label :usn, "USN", class: admin_label_classes %>
          <%= sp.text_field :usn, class: admin_input_classes %>
        </div>

        <div>
          <%= sp.label :department_id, "Department", class: admin_label_classes %>
          <%= sp.collection_select :department_id, Department.order(:name), :id, :name,
                { prompt: "Select a department" }, class: admin_input_classes %>
        </div>

        <div>
          <%= sp.label :section, class: admin_label_classes %>
          <%= sp.text_field :section, class: admin_input_classes %>
        </div>
      <% end %>
    </fieldset>

    <div>
      <%= f.label :password, class: admin_label_classes %>
      <% if user.persisted? %>
        <span class="text-xs text-slate-500">(leave blank to keep the current password)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: admin_input_classes %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: admin_label_classes %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: admin_input_classes %>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit class: admin_primary_button_classes %>
      <%= link_to "Cancel", admin_users_path, class: admin_link_classes %>
    </div>
  <% end %>
</div>
