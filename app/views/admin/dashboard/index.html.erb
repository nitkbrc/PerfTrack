<div class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <div class="relative overflow-hidden rounded-3xl p-8 shadow-xl lg:col-span-2"
         style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%); min-height: 200px;">
      <div class="pointer-events-none absolute right-0 top-0 h-64 w-64 rounded-full opacity-20"
           style="background: radial-gradient(circle at top right, #93c5fd, transparent 65%)"></div>

      <div class="relative flex h-full flex-col justify-center gap-2">
        <p class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
          <%= current_user.name.presence || current_user.email %>
        </p>
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white">Admin console</p>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-white">
          Accounts and structure across the whole institution.
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/25">
            <%= @user_count %> accounts
          </span>
          <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/25">
            <%= @division_count %> active divisions
          </span>
        </div>
      </div>
    </div>

    <div class="clay-card flex flex-col justify-center gap-3 rounded-3xl p-6">
      <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-400">Quick links</p>
      <%= link_to "Manage divisions", admin_divisions_path, class: "scats-primary-button w-full" %>
      <%= link_to "Manage users", admin_users_path, class: "scats-secondary-button w-full" %>
      <%= link_to "Import users", new_admin_user_import_path, class: "scats-ghost-button w-full" %>
    </div>
  </div>

  <section>
    <h2 class="mb-3 text-sm font-semibold text-text-main">Accounts</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <%= render "shared/stat_tile",
            icon: "group", tone: :blue, variant: :wide,
            span: "sm:col-span-2",
            value: @user_count, label: "Total users",
            sub: "Every account on the system",
            href: admin_users_path %>
      <%= render "shared/stat_tile",
            icon: "school", tone: :sky,
            value: @student_count, label: "Students" %>
      <%= render "shared/stat_tile",
            icon: "badge", tone: :indigo,
            value: @faculty_count, label: "Faculty" %>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-sm font-semibold text-text-main">Structure &amp; catalog</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      <%= render "shared/stat_tile",
            icon: "grid_view", tone: :violet,
            value: @department_count, label: "Departments",
            href: admin_departments_path %>
      <%= render "shared/stat_tile",
            icon: "account_tree", tone: :teal,
            value: @division_count, label: "Divisions",
            href: admin_divisions_path %>
      <%= render "shared/stat_tile",
            icon: "folder", tone: :indigo,
            value: @sub_division_count, label: "Sub-divisions",
            href: admin_sub_divisions_path %>
      <%= render "shared/stat_tile",
            icon: "category", tone: :emerald,
            value: @category_count, label: "Categories",
            href: admin_categories_path %>
      <%= render "shared/stat_tile",
            icon: "list_alt", tone: :slate,
            value: @reason_template_count, label: "Reason templates",
            href: admin_reason_templates_path %>
    </div>
  </section>
</div>
