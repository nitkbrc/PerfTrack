<%# locals: steps — array of [number, full_label, short_label] %>
<% steps = local_assigns.fetch(:steps) %>
<% start_step = local_assigns.fetch(:start_step, 1) %>

<div class="mb-8 rounded-2xl border border-slate-200 bg-white px-3 py-5 shadow-sm sm:px-6">
  <div class="flex">
    <% steps.each_with_index do |(num, label, short_label), i| %>
      <% step_num = i + 1 %>
      <% completed = start_step > step_num %>
      <% active = start_step == step_num %>
      <div data-owner-create-wizard-target="progressStep" class="flex min-w-0 flex-1 flex-col items-center">
        <div class="flex w-full items-center">
          <% if i > 0 %>
            <div data-owner-create-wizard-target="progressConnector"
                 class="h-px flex-1 bg-slate-200 transition-colors duration-200"></div>
          <% else %>
            <div class="flex-1" aria-hidden="true"></div>
          <% end %>

          <span data-progress-icon
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 text-sm font-bold transition-colors duration-200 <%= completed || active ? "border-transparent text-white" : "border-slate-200 text-slate-400" %>"
                style="background-color: <%= completed ? "#16a34a" : (active ? "#2563eb" : "#ffffff") %>">
            <span data-progress-number
                  class="<%= completed ? "hidden" : "" %>"
                  <%= completed ? 'aria-hidden="true"' : "" %>><%= num %></span>
            <span data-progress-check
                  class="material-symbols-outlined text-[20px] leading-none <%= completed ? "" : "hidden" %>"
                  <%= completed ? "" : 'aria-hidden="true"' %>>check</span>
          </span>

          <% if i < steps.length - 1 %>
            <div data-owner-create-wizard-target="progressConnector"
                 class="h-px flex-1 bg-slate-200 transition-colors duration-200"></div>
          <% else %>
            <div class="flex-1" aria-hidden="true"></div>
          <% end %>
        </div>

        <span data-progress-label
              class="mt-2 max-w-[5.5rem] text-center text-[11px] font-semibold leading-tight transition-colors duration-200 sm:max-w-none sm:text-xs"
              style="color: <%= completed ? "#16a34a" : (active ? "#2563eb" : "#94a3b8") %>">
          <span class="sm:hidden"><%= short_label %></span>
          <span class="hidden sm:inline"><%= label %></span>
        </span>
      </div>
    <% end %>
  </div>
</div>
