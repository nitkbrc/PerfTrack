<%= form_with model: [ :admin, assignment ], class: "space-y-5" do |f| %>
  <%= render "admin/shared/error_messages", record: assignment %>

  <div>
    <%= f.label :review_role_id, "Review role", class: admin_label_classes %>
    <%= f.collection_select :review_role_id, @review_roles, :id, :name, { prompt: "Select role" }, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :user_id, "Faculty", class: admin_label_classes %>
    <%= f.collection_select :user_id, @eligible_users, :id, ->(u) { u.name.presence || u.email },
          { prompt: "Select faculty" }, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :division_id, "Division (for division-scoped roles)", class: admin_label_classes %>
    <%= f.collection_select :division_id, @divisions, :id, :name, { include_blank: "—" }, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :sub_division_id, "Sub-division (for sub-division-scoped roles)", class: admin_label_classes %>
    <%= f.collection_select :sub_division_id, @sub_divisions, :id,
          ->(sd) { "#{sd.division.name} / #{sd.name}" },
          { include_blank: "—" }, class: admin_input_classes %>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit class: admin_primary_button_classes %>
    <button type="button" data-action="modal#close" class="<%= admin_link_classes %>">Cancel</button>
  </div>
<% end %>
