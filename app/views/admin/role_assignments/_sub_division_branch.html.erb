<%
  slots = role_slots_for(sub_division)
  vacant_count = slots.count(&:vacant?)
  has_template = sub_division.hierarchy_id.present?
  open_branch = vacant_count.positive? || !has_template
%>
<li role="treeitem"
    class="rounded-lg border border-border-subtle bg-slate-50/80 p-2"
    data-vacancy-filter-target="branch"
    data-vacant-count="<%= vacant_count %>"
    data-no-template="<%= !has_template %>">
  <details class="group/branch" data-tree-target="node" <%= "open" if open_branch %>>
    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-2 transition hover:bg-white [&::-webkit-details-marker]:hidden">
      <span class="material-symbols-outlined shrink-0 text-base text-slate-400 transition group-open/branch:rotate-90"
            aria-hidden="true">chevron_right</span>
      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-teal-700">
        <span class="material-symbols-outlined text-base" style="font-variation-settings:'FILL' 1" aria-hidden="true">folder</span>
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-sm font-semibold text-text-main"><%= sub_division.name %></span>
        <span class="block text-xs text-text-muted">
          <% if has_template %>
            <%= role_slots_staffed_summary(slots) %>
          <% else %>
            No template attached
          <% end %>
        </span>
      </span>
      <% if vacant_count.positive? %>
        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-semibold text-red-700">
          <%= pluralize(vacant_count, "vacant") %>
        </span>
      <% end %>
    </summary>

    <ul class="mt-1 space-y-2 px-1 pb-0.5 sm:px-2" role="group">
      <% if has_template %>
        <% slots.each do |slot| %>
          <%= render "admin/role_assignments/role_slot", slot: slot %>
        <% end %>
      <% else %>
        <li class="rounded-xl border border-dashed border-amber-200 bg-amber-50/50 px-4 py-4 text-sm text-amber-900">
          Attach a sub-division hierarchy template on the
          <%= link_to "Hierarchy templates", admin_hierarchies_path, class: admin_link_classes %>
          page before assigning people here.
        </li>
      <% end %>
    </ul>
  </details>
</li>
