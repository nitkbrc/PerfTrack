<div class="w-full space-y-10 pb-28"
     data-controller="hierarchy-templates unsaved-changes"
     data-unsaved-changes-strategy-value="custom"
     data-hierarchy-templates-save-url-value="<%= bulk_save_admin_hierarchies_path %>">

  <%# ── Page header ─────────────────────────────────────────────── %>
  <header class="space-y-6">
    <%= link_to edit_admin_settings_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-primary" do %>
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
      Settings
    <% end %>

    <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-5">
      <div class="min-w-0 max-w-2xl">
        <h1 class="text-[26px] font-semibold leading-tight tracking-tight text-slate-900">Hierarchy templates</h1>
        <p class="mt-2.5 text-sm leading-relaxed text-slate-500">
          Build a review chain once, then attach the divisions and sub-divisions that follow it.
          Reorder roles with the arrows (final approver at the top, first reviewer at the bottom).
          Move units between templates from the ⋮ menu, or use Assign. Every unit stays on a template.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <%= link_to admin_role_assignments_path,
              class: "inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50" do %>
          <span class="material-symbols-outlined text-lg text-slate-400" aria-hidden="true">group</span>
          Assign people
        <% end %>
      </div>
    </div>
  </header>

  <%# ── Overview ───────────────────────────────────────────────── %>
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 lg:grid-cols-3">
    <% [
         { label: "Templates", value: @stats[:templates], hint: "across both scopes" },
         { label: "Attached units", value: @stats[:attached], hint: "divisions and sub-divisions" },
         { label: "Unstaffed", value: @stats[:unstaffed], hint: "cannot accept new requests", tone: :danger }
       ].each do |stat| %>
      <div class="bg-white px-6 py-5">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-slate-400"><%= stat[:label] %></p>
        <p class="mt-2.5 text-3xl font-semibold tracking-tight
                  <%= if stat[:value].to_i.zero?
                        "text-slate-900"
                      elsif stat[:tone] == :danger
                        "text-red-600"
                      elsif stat[:tone] == :warning
                        "text-amber-600"
                      else
                        "text-slate-900"
                      end %>">
          <%= stat[:value] %>
        </p>
        <p class="mt-1.5 text-xs leading-relaxed text-slate-400"><%= stat[:hint] %></p>
      </div>
    <% end %>
  </div>

  <%# Flash banners come from the admin layout. %>

  <%# ── Template rails ─────────────────────────────────────────── %>
  <div class="space-y-12">
    <%= render "admin/hierarchies/scope_section",
               title: "Division hierarchies",
               subtitle: "Run after a sub-division finishes its review.",
               icon: "layers",
               scope: "division",
               hierarchies: @division_hierarchies,
               available_roles: @division_roles %>

    <%= render "admin/hierarchies/scope_section",
               title: "Sub-division hierarchies",
               subtitle: "First-line review chains attached to individual sub-divisions.",
               icon: "folder",
               scope: "sub_division",
               hierarchies: @sub_division_hierarchies,
               available_roles: @sub_division_roles %>
  </div>

  <%= render "shared/unsaved_changes_bar",
        hint: "Structure saves even if some units are still unstaffed.",
        discard_path: admin_hierarchies_path,
        save_action: "click->unsaved-changes#save" %>

  <form data-hierarchy-templates-target="form" method="post" action="<%= bulk_save_admin_hierarchies_path %>" accept-charset="UTF-8" class="hidden">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <input type="hidden" name="payload" value="" data-hierarchy-templates-target="payload">
  </form>
</div>
