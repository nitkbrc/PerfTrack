<%
  owner_noun = scope == "division" ? "division" : "sub-division"
%>
<section class="space-y-6" data-controller="tree" data-scope-section data-hierarchy-scope="<%= scope %>" aria-labelledby="hierarchy-scope-<%= scope %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg
                   <%= scope == "division" ? "bg-blue-50 text-blue-700" : "bg-teal-50 text-teal-700" %>">
        <span class="material-symbols-outlined text-lg" aria-hidden="true"><%= icon %></span>
      </span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <h2 id="hierarchy-scope-<%= scope %>" class="text-base font-semibold tracking-tight text-slate-900"><%= title %></h2>
          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500">
            <%= hierarchies.size %>
          </span>
        </div>
        <p class="mt-1 text-sm text-slate-500 sm:truncate"><%= subtitle %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button"
              class="scats-ghost-button !px-3 !py-1.5 text-xs"
              data-tree-target="toggle"
              data-action="tree#toggle"
              aria-expanded="false">
        Expand all
      </button>
      <div class="mx-0.5 hidden h-5 w-px bg-slate-200 sm:block" aria-hidden="true"></div>
      <button type="button"
              class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollPrev"
              aria-label="Scroll <%= title.downcase %> left">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_left</span>
      </button>
      <button type="button"
              class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollNext"
              aria-label="Scroll <%= title.downcase %> right">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_right</span>
      </button>
    </div>
  </div>

  <div class="rounded-xl border border-amber-200/80 bg-amber-50/50 px-4 py-4 sm:px-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-start sm:gap-x-4 sm:gap-y-3">
      <div class="min-w-0 shrink-0 sm:max-w-xs">
        <p class="flex items-center gap-2 text-sm font-medium text-amber-900">
          <span class="material-symbols-outlined text-lg text-amber-500" aria-hidden="true">inventory_2</span>
          Not on a template yet
        </p>
        <p class="mt-1 text-xs leading-relaxed text-amber-800/70">
          Open the ⋮ menu to move a unit onto a template, or use <span class="font-medium">Assign</span> on a card.
        </p>
      </div>
      <ul class="flex min-w-0 flex-1 flex-wrap gap-2"
          data-owner-list
          data-owner-tray>
        <% if unassigned_owners.any? %>
          <% unassigned_owners.each do |owner| %>
            <li class="flex max-w-full items-center gap-1 rounded-xl border border-amber-200 bg-white py-1.5 pl-3 pr-1 text-sm font-medium text-slate-700 shadow-sm"
                data-owner-id="<%= owner.id %>"
                data-owner-type="<%= owner.class.name %>">
              <span class="min-w-0 flex-1 truncate" data-owner-label>
                <%= owner.is_a?(SubDivision) ? "#{owner.division.name} / #{owner.name}" : owner.name %>
              </span>
              <details class="relative shrink-0" data-owner-menu data-action="toggle->hierarchy-templates#openOwnerMenu">
                <summary class="flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 [&::-webkit-details-marker]:hidden"
                         aria-label="Actions for <%= owner.name %>">
                  <span class="material-symbols-outlined text-xl" aria-hidden="true">more_vert</span>
                </summary>
                <div class="absolute right-0 z-30 mt-1.5 w-56 overflow-hidden rounded-xl border border-slate-200 bg-white py-1.5 shadow-xl"
                     data-owner-move-menu>
                  <p class="px-4 pb-1 pt-1.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Move to</p>
                  <div data-owner-move-destinations>
                    <p class="px-4 py-2 text-xs text-slate-400">No other destinations</p>
                  </div>
                </div>
              </details>
            </li>
          <% end %>
        <% else %>
          <li class="rounded-lg border border-dashed border-amber-200/80 px-3 py-2 text-xs text-amber-800/60" data-empty-tray>
            All <%= owner_noun.pluralize %> are on a template.
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="scats-card-rail -mx-1 flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto overflow-y-hidden px-1 pb-5 sm:gap-6" data-card-rail>
    <% hierarchies.each do |hierarchy| %>
      <%= render "admin/hierarchies/hierarchy_card",
                 hierarchy: hierarchy,
                 available_roles: available_roles,
                 scope: scope %>
    <% end %>

    <%= button_to admin_hierarchies_path,
          params: { scope: scope },
          method: :post,
          class: "group flex w-full max-w-md shrink-0 snap-start cursor-pointer flex-col items-center justify-center gap-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50/40 p-8 text-center transition hover:border-primary/40 hover:bg-white sm:w-[22rem] lg:w-[23rem]" do %>
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm ring-1 ring-slate-200 transition group-hover:text-primary group-hover:ring-primary/30">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">add</span>
      </span>
      <span class="block">
        <span class="block text-sm font-semibold text-slate-700">New template</span>
        <span class="mt-1.5 block max-w-[15rem] text-xs leading-relaxed text-slate-400">
          Starts with <%= scope == "division" ? "Dean" : "Supervisor" %>, then add the roles you need.
        </span>
      </span>
    <% end %>
  </div>
</section>
