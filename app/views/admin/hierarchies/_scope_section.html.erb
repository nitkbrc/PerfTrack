<section class="space-y-6" data-scope-section data-hierarchy-scope="<%= scope %>" aria-labelledby="hierarchy-scope-<%= scope %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
        <span class="material-symbols-outlined text-lg" aria-hidden="true"><%= icon %></span>
      </span>
      <div class="min-w-0">
        <div class="flex items-center gap-2.5">
          <h2 id="hierarchy-scope-<%= scope %>" class="text-base font-semibold tracking-tight text-slate-900"><%= title %></h2>
          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500">
            <%= hierarchies.size %>
          </span>
        </div>
        <p class="mt-1 truncate text-sm text-slate-500"><%= subtitle %></p>
      </div>
    </div>

    <div class="flex items-center gap-1.5">
      <button type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollPrev"
              aria-label="Scroll <%= title.downcase %> left">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_left</span>
      </button>
      <button type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollNext"
              aria-label="Scroll <%= title.downcase %> right">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_right</span>
      </button>
    </div>
  </div>

  <% if unassigned_owners.any? %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 rounded-xl border border-amber-200 bg-amber-50/60 px-5 py-4">
      <p class="flex items-center gap-2 text-sm font-medium text-amber-900">
        <span class="material-symbols-outlined text-lg text-amber-500" aria-hidden="true">inventory_2</span>
        Not on a template yet
      </p>
      <ul class="flex flex-wrap gap-2"
          data-owner-list
          data-owner-tray
          data-action="dragover->hierarchy-templates#ownerDragOver drop->hierarchy-templates#ownerDrop">
        <% unassigned_owners.each do |owner| %>
          <li class="flex cursor-grab items-center gap-2 rounded-lg border border-amber-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm"
              draggable="true"
              data-owner-id="<%= owner.id %>"
              data-owner-type="<%= owner.class.name %>"
              data-action="dragstart->hierarchy-templates#ownerDragStart dragend->hierarchy-templates#ownerDragEnd">
            <span class="material-symbols-outlined text-base text-amber-400" aria-hidden="true">drag_indicator</span>
            <span data-owner-label><%= owner.is_a?(SubDivision) ? "#{owner.division.name} / #{owner.name}" : owner.name %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="scats-card-rail -mx-1 flex snap-x items-stretch gap-6 overflow-x-auto overflow-y-hidden px-1 pb-5" data-card-rail>
    <% hierarchies.each do |hierarchy| %>
      <%= render "admin/hierarchies/hierarchy_card",
                 hierarchy: hierarchy,
                 available_roles: available_roles,
                 scope: scope %>
    <% end %>

    <%= button_to admin_hierarchies_path,
          params: { scope: scope },
          method: :post,
          class: "group flex w-[23rem] shrink-0 snap-start cursor-pointer flex-col items-center justify-center gap-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50/40 p-8 text-center transition hover:border-primary/40 hover:bg-white" do %>
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm ring-1 ring-slate-200 transition group-hover:text-primary group-hover:ring-primary/30">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">add</span>
      </span>
      <span class="block">
        <span class="block text-sm font-semibold text-slate-700">New template</span>
        <span class="mt-1.5 block max-w-[15rem] text-xs leading-relaxed text-slate-400">
          Starts with <%= scope == "division" ? "Dean" : "Supervisor" %>, then add the roles you need.
        </span>
      </span>
    <% end %>
  </div>
</section>
