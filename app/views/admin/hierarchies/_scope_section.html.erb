<section class="space-y-6" data-controller="tree" data-scope-section data-hierarchy-scope="<%= scope %>" aria-labelledby="hierarchy-scope-<%= scope %>">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg
                   <%= scope == "division" ? "bg-blue-50 text-blue-700" : "bg-teal-50 text-teal-700" %>">
        <span class="material-symbols-outlined text-lg" aria-hidden="true"><%= icon %></span>
      </span>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <h2 id="hierarchy-scope-<%= scope %>" class="text-base font-semibold tracking-tight text-slate-900"><%= title %></h2>
          <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500">
            <%= hierarchies.size %>
          </span>
        </div>
        <p class="mt-1 text-sm text-slate-500 sm:truncate"><%= subtitle %></p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button"
              class="scats-ghost-button !px-3 !py-1.5 text-xs"
              data-tree-target="toggle"
              data-action="tree#toggle"
              aria-expanded="false">
        Expand all
      </button>
      <div class="mx-0.5 hidden h-5 w-px bg-slate-200 sm:block" aria-hidden="true"></div>
      <button type="button"
              class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollPrev"
              aria-label="Scroll <%= title.downcase %> left">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_left</span>
      </button>
      <button type="button"
              class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-400 transition hover:border-slate-300 hover:text-slate-700"
              data-action="hierarchy-templates#scrollNext"
              aria-label="Scroll <%= title.downcase %> right">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chevron_right</span>
      </button>
    </div>
  </div>

  <div class="scats-card-rail -mx-1 flex snap-x snap-mandatory items-stretch gap-4 overflow-x-auto overflow-y-hidden px-1 pb-5 sm:gap-6" data-card-rail>
    <% hierarchies.each do |hierarchy| %>
      <%= render "admin/hierarchies/hierarchy_card",
                 hierarchy: hierarchy,
                 available_roles: available_roles,
                 scope: scope %>
    <% end %>

    <%= button_to admin_hierarchies_path,
          params: { scope: scope },
          method: :post,
          class: "group flex w-full max-w-md shrink-0 snap-start cursor-pointer flex-col items-center justify-center gap-4 rounded-2xl border border-dashed border-slate-300 bg-slate-50/40 p-8 text-center transition hover:border-primary/40 hover:bg-white sm:w-[22rem] lg:w-[23rem]" do %>
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white text-slate-400 shadow-sm ring-1 ring-slate-200 transition group-hover:text-primary group-hover:ring-primary/30">
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">add</span>
      </span>
      <span class="block">
        <span class="block text-sm font-semibold text-slate-700">New template</span>
        <span class="mt-1.5 block max-w-[15rem] text-xs leading-relaxed text-slate-400">
          Starts with <%= scope == "division" ? "Dean" : "Supervisor" %>, then add the roles you need.
        </span>
      </span>
    <% end %>
  </div>
</section>
