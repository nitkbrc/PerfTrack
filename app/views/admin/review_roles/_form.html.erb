<%= form_with model: [ :admin, review_role ], class: "space-y-5" do |f| %>
  <%= render "admin/shared/error_messages", record: review_role %>

  <div>
    <%= f.label :name, class: admin_label_classes %>
    <%= f.text_field :name, autofocus: true, class: admin_input_classes %>
  </div>

  <div>
    <%= f.label :scope, class: admin_label_classes %>
    <%= f.select :scope, ReviewRole.scopes.keys.map { |s| [ s.humanize, s ] }, {},
          class: admin_input_classes, disabled: review_role.system_role? %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :raiseable_on_behalf_eligible %>
    <%= f.label :raiseable_on_behalf_eligible, "Eligible to raise on behalf (sub-division roles only)" %>
  </div>

  <div class="flex items-center gap-4">
    <%= f.submit class: admin_primary_button_classes %>
    <button type="button" data-action="modal#close" class="<%= admin_link_classes %>">Cancel</button>
  </div>
<% end %>
