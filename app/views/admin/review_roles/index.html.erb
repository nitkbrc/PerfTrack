<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-text-main">Review roles</h1>
  <%= link_to "New role", new_admin_review_role_path, class: admin_primary_button_classes, data: admin_modal_frame_data %>
</div>

<div class="clay-card scats-list-shell">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Scope</th>
        <th class="px-4 py-3">Raiseable</th>
        <th class="px-4 py-3">System</th>
        <th class="px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="scats-list">
      <% @review_roles.each do |role| %>
        <tr class="scats-row">
          <td class="px-4 py-3 font-medium"><%= role.name %></td>
          <td class="px-4 py-3"><%= role.scope.humanize %></td>
          <td class="px-4 py-3"><%= role.raiseable_on_behalf_eligible? ? "Yes" : "—" %></td>
          <td class="px-4 py-3"><%= role.system_role? ? "Yes" : "No" %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to admin_edit_action_label, edit_admin_review_role_path(role), class: admin_secondary_button_classes, data: admin_modal_frame_data %>
            <% unless role.system_role? %>
              <%= button_to "Delete", admin_review_role_path(role), method: :delete,
                    form: { data: { turbo_confirm: "Delete this role?" } },
                    class: admin_delete_classes %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
