<div class="mx-auto w-full max-w-6xl">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-text-main">Review queue</h1>
  </div>

  <% if @sub_divisions.many? %>
    <div class="mb-4 flex flex-wrap gap-2">
      <%= link_to "All", supervisor_queue_path,
            class: "rounded-lg px-3 py-1.5 text-sm font-medium #{@selected_sub_division.nil? ? 'bg-primary text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200'}" %>
      <% @sub_divisions.each do |sub| %>
        <%= link_to sub.name, supervisor_queue_path(sub_division_id: sub.id),
              class: "rounded-lg px-3 py-1.5 text-sm font-medium #{@selected_sub_division&.id == sub.id ? 'bg-primary text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @requests.any? %>
    <div class="clay-card scats-list-shell">
      <table class="w-full min-w-0 text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
          <tr>
            <th class="hidden w-28 px-3 py-3 sm:table-cell sm:px-4">Student</th>
            <th class="min-w-0 px-3 py-3 sm:px-4">Title</th>
            <th class="hidden w-44 px-4 py-3 lg:table-cell">Category</th>
            <th class="hidden w-28 px-4 py-3 md:table-cell">Submitted</th>
            <th class="hidden w-32 px-4 py-3 sm:table-cell">Status</th>
            <th class="w-28 whitespace-nowrap px-3 py-3 text-right sm:w-32 sm:px-4">Actions</th>
          </tr>
        </thead>
        <tbody class="scats-list">
          <% @requests.each do |request| %>
            <tr class="scats-row">
              <td class="hidden truncate px-3 py-3 font-medium text-text-main sm:table-cell sm:px-4">
                <%= request.student.usn %>
              </td>
              <td class="min-w-0 px-3 py-3 text-text-main sm:px-4">
                <div class="flex min-w-0 items-center gap-1.5">
                  <span class="truncate font-medium"><%= request.title %></span>
                  <% if request.awaiting_raiseable_revision? %>
                    <%= attention_dot("Sent back — needs your action") %>
                  <% end %>
                </div>
                <div class="mt-1 space-y-1 sm:hidden">
                  <p class="truncate text-xs font-medium text-text-muted"><%= request.student.usn %></p>
                  <p class="truncate text-xs text-text-muted">
                    <%= request.category.name %>
                    <span class="text-border-subtle">&middot;</span>
                    <%= request.created_at.strftime("%d %b %Y") %>
                  </p>
                  <div class="pt-0.5"><%= status_badge(request) %></div>
                </div>
              </td>
              <td class="hidden min-w-0 px-4 py-3 lg:table-cell">
                <p class="truncate text-xs text-text-muted"><%= request.category.sub_division.name %></p>
                <span class="scats-badge scats-badge-neutral mt-1"><%= request.category.name %></span>
              </td>
              <td class="hidden whitespace-nowrap px-4 py-3 text-text-muted md:table-cell">
                <%= request.created_at.strftime("%d %b %Y") %>
              </td>
              <td class="hidden min-w-0 px-4 py-3 sm:table-cell">
                <%= status_badge(request) %>
              </td>
              <td class="whitespace-nowrap px-3 py-3 text-right sm:px-4">
                <%= link_to "Review", supervisor_achievement_request_path(request),
                      class: "scats-primary-button px-2.5 py-1 text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="clay-card p-8 text-center text-sm text-text-muted">
      No pending requests — you're all caught up.
    </div>
  <% end %>
</div>
