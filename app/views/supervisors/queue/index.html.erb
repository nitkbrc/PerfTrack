<div class="mx-auto w-full max-w-4xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-text-main">Review queue</h1>
  </div>

  <% if @requests.any? %>
    <div class="clay-card scats-list-shell">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
          <tr>
            <th class="w-28 px-4 py-3">Student</th>
            <th class="px-4 py-3">Title</th>
            <th class="hidden px-4 py-3 md:table-cell">Category</th>
            <th class="hidden w-28 px-4 py-3 sm:table-cell">Submitted</th>
            <th class="w-24 whitespace-nowrap px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="scats-list">
          <% @requests.each do |request| %>
            <tr class="scats-row">
              <td class="truncate px-4 py-3 font-medium text-text-main"><%= request.student.usn %></td>
              <td class="min-w-0 truncate px-4 py-3 text-text-main">
                <%= request.title %>
                <% if request.dean_reverted? %>
                  <%= attention_dot("Sent back by the dean — needs your action") %>
                <% end %>
              </td>
              <td class="hidden min-w-0 px-4 py-3 md:table-cell">
                <p class="truncate text-xs text-text-muted"><%= request.category.sub_division.name %></p>
                <span class="scats-badge scats-badge-neutral mt-1"><%= request.category.name %></span>
              </td>
              <td class="hidden whitespace-nowrap px-4 py-3 text-text-muted sm:table-cell"><%= request.created_at.strftime("%d %b %Y") %></td>
              <td class="whitespace-nowrap px-4 py-3 text-right">
                <%= link_to "Review", supervisor_achievement_request_path(request),
                      class: "scats-primary-button px-2.5 py-1 text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="clay-card p-8 text-center text-sm text-text-muted">
      No pending requests — you're all caught up.
    </div>
  <% end %>
</div>
