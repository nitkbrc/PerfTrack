<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= link_to faculty_students_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-primary" do %>
      <span class="material-symbols-outlined text-base" aria-hidden="true">arrow_back</span>
      Students
    <% end %>
    <h1 class="mt-3 text-2xl font-bold text-text-main">Import students</h1>
    <p class="mt-1 text-sm text-text-muted">
      Upload a CSV to create many student accounts at once. Temporary passwords are each student’s USN typed twice.
    </p>
  </div>

  <div class="clay-card p-6 sm:p-8">
    <div class="scats-callout scats-callout-info mb-5" role="note">
      <span class="scats-callout-icon material-symbols-outlined" aria-hidden="true">info</span>
      <div class="scats-callout-body">
        <p class="scats-callout-title">CSV format</p>
        <p class="mt-1 leading-relaxed opacity-90">
          Columns:
          <code class="rounded bg-primary/10 px-1 py-0.5 text-xs text-primary">name, email, phone, address, usn, department, sem</code>.
          Role is always student — do not include a role column.
        </p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm opacity-90">
          <li><code>phone</code>, <code>address</code>, and <code>usn</code> are required. Phone numbers must be unique.</li>
          <li>A placeholder photo is attached; students can replace it later if allowed.</li>
          <li>
            <code>department</code> must match an existing name:
            <span class="font-semibold"><%= Department.order(:name).pluck(:name).join(", ").presence || "none created yet — ask an admin to add departments first" %></span>
          </li>
          <li>Rows with errors are skipped — everything else still imports.</li>
        </ul>
      </div>
    </div>

    <%= form_with url: faculty_student_imports_path, multipart: true, data: { turbo: false }, class: "space-y-5" do %>
      <div>
        <%= label_tag :file, "CSV file", class: admin_label_classes %>
        <div class="relative mt-1" data-controller="file-picker">
          <%= file_field_tag :file, accept: ".csv,text/csv",
                tabindex: -1,
                aria: { hidden: true },
                class: "pointer-events-none absolute h-0 w-0 overflow-hidden opacity-0",
                data: {
                  file_picker_target: "input",
                  action: "change->file-picker#changed"
                } %>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button"
                    data-action="file-picker#pick"
                    class="<%= admin_primary_button_classes %>">
              Choose file
            </button>
            <span data-file-picker-target="name" class="text-sm text-text-muted">No file chosen</span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <%= submit_tag "Import students", class: admin_primary_button_classes %>
        <%= link_to "Download template", template_faculty_student_imports_path, class: "scats-secondary-button" %>
        <%= link_to "Cancel", faculty_students_path, class: "scats-ghost-button" %>
      </div>
    <% end %>
  </div>
</div>
