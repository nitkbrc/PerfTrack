<div class="mx-auto w-full max-w-4xl">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="mb-1 text-2xl font-bold text-text-main">Students</h1>
      <p class="text-sm text-text-muted">All students with their current overall score. Select a student for the full breakdown.</p>
    </div>
    <% if @can_create_students %>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to "Add student", new_faculty_student_path, class: admin_primary_button_classes %>
        <%= link_to "Import CSV", new_faculty_student_import_path, class: "scats-secondary-button" %>
      </div>
    <% end %>
  </div>

  <%= form_with url: faculty_students_path, method: :get, class: "clay-card mb-6 flex flex-col gap-3 p-4 sm:p-5" do |f| %>
    <div class="w-full">
      <%= f.search_field :q, value: params[:q], placeholder: "Search name, email, or USN", class: "#{admin_input_classes} mt-0 w-full" %>
    </div>
    <div class="grid grid-cols-1 items-end gap-3 sm:grid-cols-3">
      <div class="min-w-0">
        <%= f.collection_select :department_id, @departments, :id, :name, { include_blank: "All departments", selected: params[:department_id] }, class: "#{admin_input_classes} mt-0 w-full" %>
      </div>
      <div class="min-w-0">
        <%= f.select :sem, [["All semesters", ""]] + (1..8).map { |sem| ["Semester #{sem}", sem] }, { selected: params[:sem] }, class: "#{admin_input_classes} mt-0 w-full" %>
      </div>
      <div class="flex w-full min-w-0 gap-2">
        <%= f.submit "Filter", class: "#{admin_primary_button_classes} h-10 flex-1" %>
        <%= link_to "Clear", faculty_students_path, class: "scats-ghost-button h-10 flex-1" %>
      </div>
    </div>
  <% end %>

  <% if @students.any? %>
    <div class="clay-card scats-list-shell">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-text-muted">
          <tr>
            <th class="w-16 px-3 py-3 sm:px-4">Photo</th>
            <th class="px-3 py-3 sm:px-4">Name</th>
            <th class="w-32 px-3 py-3 sm:px-4">USN</th>
            <th class="hidden px-3 py-3 sm:table-cell sm:px-4">Department</th>
            <th class="w-24 whitespace-nowrap px-3 py-3 text-right sm:px-4">Sem</th>
            <th class="w-28 whitespace-nowrap px-3 py-3 text-right sm:px-4">SCATS Score</th>
          </tr>
        </thead>
        <tbody class="scats-list">
          <% @students.each do |student| %>
            <tr class="scats-row relative cursor-pointer">
              <td class="scats-list-photo px-3 py-3 sm:px-4">
                <%= link_to "", faculty_student_path(student),
                      class: "absolute inset-0 z-0",
                      aria: { label: "View #{student.user.name.presence || student.user.email}" } %>
                <div class="pointer-events-none relative z-10 inline-flex shrink-0 p-0.5">
                  <%= user_photo_tag(student.user, size: 36) %>
                </div>
              </td>
              <td class="pointer-events-none relative z-10 min-w-0 truncate px-3 py-3 font-medium text-text-main sm:px-4">
                <%= student.user.name.presence || student.user.email %>
              </td>
              <td class="pointer-events-none relative z-10 truncate px-3 py-3 text-text-muted sm:px-4"><%= student.usn %></td>
              <td class="pointer-events-none relative z-10 hidden min-w-0 truncate px-3 py-3 text-text-muted sm:table-cell sm:px-4"><%= student.department.name %></td>
              <td class="pointer-events-none relative z-10 whitespace-nowrap px-3 py-3 text-right text-text-muted sm:px-4">
                <%= student.sem.presence || "—" %>
              </td>
              <td class="pointer-events-none relative z-10 whitespace-nowrap px-3 py-3 text-right sm:px-4">
                <%= score_badge(@scores[student.id]) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="clay-card p-8 text-center text-sm text-text-muted">
      No students found.
    </div>
  <% end %>
</div>
