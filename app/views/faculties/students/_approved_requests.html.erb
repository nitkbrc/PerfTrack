<% if requests.any? %>
  <ul class="space-y-3">
    <% requests.each do |request| %>
      <li class="clay-card p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium text-text-main"><%= request.title %></p>
            <p class="mt-1 text-xs text-text-muted">
              <%= request.display_sub_division_name %>
            </p>
            <span class="scats-badge scats-badge-neutral mt-1.5"><%= request.display_category_name %></span>
          </div>
          <% if request.points_awarded.positive? %>
            <span class="scats-badge scats-badge-success shrink-0">+<%= request.points_awarded %> pts</span>
          <% else %>
            <span class="scats-badge scats-badge-danger shrink-0"><%= request.points_awarded %> pts</span>
          <% end %>
        </div>
        <p class="mt-2 text-xs text-text-muted">Approved <%= request.updated_at.strftime("%d %b %Y") %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="clay-card p-6 text-center text-sm text-text-muted">
    <%= empty_message %>
  </div>
<% end %>
