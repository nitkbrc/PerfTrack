<% full = intensity.to_sym == :full %>
<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-[#1a237e]"
     data-controller="campus-rotator"
     data-campus-rotator-full-value="<%= full %>">
  <% campus_image_paths.each_with_index do |path, index| %>
    <%= image_tag path, data: { campus_rotator_target: "image" },
          class: "absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 #{index.zero? ? '' : 'opacity-0'}",
          alt: "" %>
  <% end %>
  <% if full %>
    <div class="absolute inset-0 bg-[#000666]/55"></div>
  <% else %>
    <div class="absolute inset-0 bg-[#000666]/28"></div>
    <div class="absolute inset-0 bg-[#f7faf9]/68"></div>
  <% end %>
</div>
