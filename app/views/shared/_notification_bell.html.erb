<%# Eager bell chrome in the initial HTML so the icon never flashes empty.
    Mark-read still refreshes this same frame via notifications#index.
    Sidebar (desktop) and top bar (mobile) use distinct frame ids. %>
<%
  notifications = local_assigns.fetch(:notifications) {
    current_user.notifications.includes(:achievement_request).order(created_at: :desc).limit(20)
  }
  unread_count = local_assigns.fetch(:unread_count) {
    current_user.notifications.unread.count
  }
  open = local_assigns.fetch(:open, false)
  frame_id = local_assigns.fetch(:frame_id, "notifications")
  variant = local_assigns.fetch(:variant, :sidebar).to_sym
  summary_classes = case variant
                    when :topbar
                      "relative flex cursor-pointer items-center justify-center rounded-md p-2 text-[#1a237e] transition hover:bg-[#f1f4f3]"
                    else
                      "relative flex cursor-pointer items-center gap-1 rounded-lg p-1.5 text-white/80 transition hover:bg-white/10 hover:text-white"
                    end
  icon_classes = variant == :topbar ? "text-[#1a237e]" : "text-white/80"
%>
<%= turbo_frame_tag frame_id do %>
  <details class="relative" data-controller="notifications-panel" <%= "open" if open %>>
    <summary class="list-none [&::-webkit-details-marker]:hidden <%= summary_classes %>"
             aria-label="Notifications"
             title="Notifications">
      <span class="material-symbols-outlined <%= icon_classes %>" aria-hidden="true">notifications</span>
      <% if unread_count.positive? %>
        <span class="absolute -right-0.5 -top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-red-600 px-1 text-xs font-bold text-white">
          <%= unread_count %>
        </span>
      <% end %>
    </summary>

    <div data-notifications-panel-target="layer"
         class="scats-notifications-layer fixed inset-0 z-[70] flex items-center justify-center p-4 sm:p-6">
      <button type="button"
              class="scats-notifications-scrim absolute inset-0 cursor-default border-0"
              data-notifications-panel-close
              aria-label="Close notifications"></button>

      <div class="scats-notifications-panel relative z-10 flex w-full max-w-md flex-col"
           role="dialog"
           aria-modal="true"
           aria-labelledby="notifications-title-<%= frame_id %>">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h3 id="notifications-title-<%= frame_id %>" class="text-base font-semibold text-[#212529]">Notifications</h3>
          <div class="flex items-center gap-3">
            <% if unread_count.positive? %>
              <%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch,
                    form: { data: { turbo_frame: frame_id } },
                    class: "cursor-pointer text-xs font-medium text-[#000666] hover:text-[#1a237e]" %>
            <% end %>
            <button type="button" data-notifications-panel-close aria-label="Close notifications"
                    class="cursor-pointer rounded-md p-1 text-[#6C757D] transition hover:bg-[#e0e0ff] hover:text-[#000666]">
              <span class="material-symbols-outlined text-base" aria-hidden="true">close</span>
            </button>
          </div>
        </div>

        <% if notifications.any? %>
          <ul class="max-h-[min(24rem,60vh)] space-y-2 overflow-y-auto overscroll-contain pr-0.5">
            <% notifications.each do |notification| %>
              <li class="rounded-md border p-2.5 text-sm <%= notification.read? ? "border-[#DEE2E6] bg-[#f1f4f3] text-[#6C757D]" : "border-[#668efe]/40 bg-[#e0e0ff] text-[#000666]" %>">
                <p><%= notification.message %></p>
                <div class="mt-1.5 flex items-center justify-between gap-2">
                  <span class="text-xs <%= notification.read? ? "text-[#6C757D]" : "text-[#2857c4]" %>">
                    <%= notification.created_at.strftime("%d %b, %H:%M") %>
                  </span>
                  <% unless notification.read? %>
                    <%= button_to "Mark read", mark_read_notification_path(notification), method: :patch,
                          form: { data: { turbo_frame: frame_id } },
                          class: "cursor-pointer text-xs font-medium text-[#000666] hover:text-[#1a237e]" %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="py-6 text-center text-sm text-[#6C757D]">No notifications yet.</p>
        <% end %>
      </div>
    </div>
  </details>
<% end %>
