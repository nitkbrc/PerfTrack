<div>
  <p class="<%= local_assigns.fetch(:label_class, "block text-sm font-medium text-slate-700") %>">
    Current proofs
  </p>
  <p class="mt-1 text-xs text-slate-500">Tap or click the corner × to remove a proof immediately. At least one proof must remain.</p>
  <div class="mt-2 flex flex-wrap gap-4">
    <% proofs.each do |proof| %>
      <div
        class="group relative h-20 w-20 overflow-visible"
        data-controller="proof-remove"
        data-proof-remove-url-value="<%= local_assigns.fetch(:remove_path).call(proof) %>"
        data-proof-remove-proof-id-value="proof_<%= proof.blob_id %>">
        <div id="proof_<%= proof.blob_id %>" class="relative h-full w-full overflow-hidden rounded-xl">
          <%= image_tag proof,
                class: local_assigns.fetch(:image_class, "h-20 w-20 rounded-lg border border-slate-200 object-cover") %>
          <div class="pointer-events-none absolute inset-0 z-10 rounded-xl bg-black/0 transition duration-200 group-hover:bg-black/20"></div>
        </div>
        <button
          type="button"
          class="absolute -right-3 -top-3 z-30 flex h-8 w-8 items-center justify-center rounded-full border border-white/40 bg-black/75 text-lg leading-none text-white opacity-100 shadow-lg backdrop-blur-sm transition duration-200 hover:scale-110 hover:bg-black/90 focus:outline-none focus:ring-2 focus:ring-white/80"
          aria-label="Remove proof"
          data-action="click->proof-remove#remove">
          <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M5 5 L15 15"></path>
            <path d="M15 5 L5 15"></path>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
</div>
