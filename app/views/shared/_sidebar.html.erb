<aside id="main-navigation" class="scats-sidebar" data-sidebar-target="panel" aria-label="Main navigation">
  <div class="scats-sidebar-header">
    <div class="flex items-center gap-3">
      <span class="scats-sidebar-mark" aria-hidden="true">S</span>
      <div>
        <p class="scats-sidebar-brand">SCATS</p>
        <p class="scats-sidebar-tagline">Character tracking</p>
      </div>
    </div>
  </div>

  <nav class="scats-sidebar-nav">
    <% navigation_items.each do |label, path, icon| %>
      <%= link_to path,
            class: "scats-nav-link #{nav_link_active?(path) ? 'scats-nav-link-active' : ''}",
            title: label,
            "aria-label": label,
            data: {
              action: "mousedown->page-nav#activate click->sidebar#close"
            } do %>
        <span class="scats-nav-icon" aria-hidden="true"><%= nav_icon(icon) %></span>
        <span class="scats-nav-label"><%= label %></span>
        <% if label == "Dashboard" && student_attention_needed? %>
          <%= attention_dot("A reverted request is waiting for you") %>
        <% elsif label == "Review queue" && supervisor_attention_needed? %>
          <%= attention_dot("A dean-reverted request is waiting for you") %>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <div class="scats-sidebar-footer">
    <% if current_user.student? %>
      <div class="scats-sidebar-notify hidden md:block">
        <%= render "shared/notification_bell", frame_id: "notifications", variant: :sidebar %>
      </div>
    <% end %>
    <%= link_to profile_path,
          class: "scats-nav-link #{current_page?(profile_path) ? 'scats-nav-link-active' : ''}",
          title: "Profile",
          "aria-label": "Profile",
          data: {
            action: "mousedown->page-nav#activate click->sidebar#close"
          } do %>
      <%= user_photo_tag(current_user, size: 28) %>
      <span class="scats-nav-label">Profile</span>
    <% end %>
    <%= button_to destroy_user_session_path,
          method: :delete,
          form: { class: "w-full" },
          class: "scats-nav-link scats-nav-link-signout w-full cursor-pointer border-0 bg-transparent text-left",
          title: "Sign out",
          "aria-label": "Sign out",
          data: {
            turbo_confirm: "Are you sure you want to sign out?\n\nYou will need to sign in again to continue.",
            action: "click->sidebar#close"
          } do %>
      <span class="scats-nav-icon" aria-hidden="true"><%= material_icon("logout") %></span>
      <span class="scats-nav-label">Sign out</span>
    <% end %>
  </div>
</aside>

<button type="button"
        class="scats-sidebar-scrim"
        data-sidebar-target="scrim"
        data-action="sidebar#close"
        aria-label="Close navigation"
        tabindex="-1"></button>
