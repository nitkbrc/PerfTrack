<%# locals: label (required), icon (optional), meta (optional), tone (optional: slate|blue|emerald). %>
<%
  icon = local_assigns.fetch(:icon, "label")
  meta = local_assigns[:meta]
  tones = {
    "slate"   => "bg-slate-100 text-slate-600",
    "blue"    => "bg-blue-50 text-blue-700",
    "emerald" => "bg-emerald-50 text-emerald-700"
  }
  chip = tones[(local_assigns[:tone] || :slate).to_s] || tones["slate"]
%>
<li class="flex items-center gap-2 rounded-lg px-2 py-1.5" role="treeitem">
  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md <%= chip %>">
    <span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1" aria-hidden="true"><%= icon %></span>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm text-text-main"><%= label %></span>
    <% if meta.present? %>
      <span class="block text-xs text-text-muted"><%= meta %></span>
    <% end %>
  </span>
</li>
