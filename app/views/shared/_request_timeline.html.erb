<% ordered = versions.to_a %>
<% latest_index = [ ordered.size - 1, 0 ].max %>
<% initial_index = local_assigns.fetch(:initial_index, latest_index) %>
<% initial_index = [[ initial_index.to_i, 0 ].max, latest_index ].min %>
<% history_only = local_assigns.fetch(:history_only, false) %>

<div class="relative px-6 sm:px-8"
     data-controller="version-carousel"
     data-version-carousel-index-value="<%= initial_index %>">
  <button type="button"
          class="absolute left-0 top-1/2 z-20 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[#000666] text-xl leading-none text-white shadow-lg transition hover:bg-[#1a237e] focus:outline-none focus:ring-2 focus:ring-[#668efe] focus:ring-offset-2 disabled:pointer-events-none disabled:hidden"
          aria-label="Previous version"
          data-version-carousel-target="prev"
          data-action="click->version-carousel#prev"
          <% if ordered.size <= 1 %>hidden disabled<% end %>>
    <span aria-hidden="true">&lsaquo;</span>
  </button>

  <div class="rounded-xl border border-[#000666]/25 bg-[var(--scats-background)] p-4 sm:p-5">
    <% if ordered.empty? %>
      <p class="text-sm text-slate-500">No versions yet.</p>
    <% else %>
      <% ordered.each_with_index do |version, index| %>
        <div data-version-carousel-target="slide"
             class="<%= index == initial_index ? '' : 'hidden' %>"
             data-version-index="<%= index %>">
          <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-base font-semibold text-slate-900">
              Version <%= version.version_number %>
              <% unless history_only %>
                <span class="font-normal text-slate-500">· <%= version.title %></span>
              <% end %>
            </h3>
            <span class="text-xs text-slate-500">
              <%= version.created_at.strftime("%d %b %Y, %H:%M") %>
            </span>
          </div>

          <% unless history_only %>
            <% if version.description.present? %>
              <p class="mb-4 whitespace-pre-line text-sm text-slate-700"><%= version.description %></p>
            <% end %>

            <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Proof</h4>
            <div class="mb-4 flex flex-wrap gap-3">
              <% version.proofs.each do |proof| %>
                <%= link_to url_for(proof), target: "_blank", rel: "noopener", class: "block" do %>
                  <%= image_tag proof, class: "h-28 w-28 rounded-lg border border-slate-200 object-cover shadow-sm transition hover:opacity-80" %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% histories = version.req_histories.sort_by(&:created_at) %>
          <% if histories.any? %>
            <% unless history_only %>
              <h4 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Review activity</h4>
            <% end %>
            <ul class="space-y-2">
              <% histories.each do |history| %>
                <li class="rounded-lg border border-slate-200 bg-white p-3 text-sm">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-medium text-slate-900"><%= history_label(history.action) %></span>
                    <span class="shrink-0 text-xs text-slate-500"><%= history.created_at.strftime("%d %b %Y, %H:%M") %></span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">
                    by <%= history.actor.name.presence || history.actor.email %>
                    <% if history.from_status.present? %>
                      · <%= history.from_status.humanize %> → <%= history.to_status.humanize %>
                    <% end %>
                  </p>
                  <% if history.comment.present? %>
                    <p class="mt-2 text-slate-700"><%= history.comment %></p>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% elsif history_only %>
            <p class="text-sm text-slate-500">No review activity for this version.</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <button type="button"
          class="absolute right-0 top-1/2 z-20 flex h-10 w-10 translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[#000666] text-xl leading-none text-white shadow-lg transition hover:bg-[#1a237e] focus:outline-none focus:ring-2 focus:ring-[#668efe] focus:ring-offset-2 disabled:pointer-events-none disabled:hidden"
          aria-label="Next version"
          data-version-carousel-target="next"
          data-action="click->version-carousel#next"
          hidden disabled>
    <span aria-hidden="true">&rsaquo;</span>
  </button>
</div>
