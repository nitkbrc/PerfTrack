<nav class="fixed inset-x-3 bottom-3 z-30 flex items-center justify-around rounded-[1.75rem] bg-[#1B4332] p-2 text-white shadow-xl md:hidden">
  <% navigation_items.first(4).each do |label, path, icon| %>
    <%= link_to path,
          class: "scats-bottom-nav-link #{nav_link_active?(path) ? 'scats-bottom-nav-link-active' : ''}",
          title: label,
          "aria-label": label,
          data: { action: "mousedown->page-nav#activate click->page-nav#activate" } do %>
      <%= nav_icon(icon, classes: "h-5 w-5") %>
    <% end %>
  <% end %>
  <% if current_user.student? %>
    <div class="relative flex shrink-0 items-center justify-center">
      <%= render "shared/notification_bell", frame_id: "notifications_mobile" %>
    </div>
  <% end %>
  <%= link_to profile_path,
        class: "scats-bottom-nav-link #{current_page?(profile_path) ? 'scats-bottom-nav-link-active' : ''}",
        title: "Profile",
        "aria-label": "Profile",
        data: { action: "mousedown->page-nav#activate click->page-nav#activate" } do %>
    <%= user_photo_tag(current_user, size: 26) %>
  <% end %>
</nav>
