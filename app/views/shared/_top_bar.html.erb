<header class="scats-topbar">
  <div class="flex min-w-0 items-center gap-3">
    <button type="button"
            class="scats-topbar-menu"
            data-sidebar-target="toggle"
            data-action="sidebar#toggle"
            aria-expanded="false"
            aria-controls="main-navigation"
            aria-label="Open navigation">
      <span class="material-symbols-outlined" aria-hidden="true">menu</span>
    </button>
    <h1 class="scats-topbar-title">
      <%= content_for?(:page_title) ? yield(:page_title) : (content_for?(:title) ? yield(:title) : "SCATS") %>
    </h1>
  </div>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <% if current_user.student? %>
      <div class="md:hidden">
        <%= render "shared/notification_bell", frame_id: "notifications_mobile", variant: :topbar %>
      </div>
    <% end %>
    <%= link_to profile_path,
          class: "scats-topbar-user py-1 pr-1",
          title: "Profile",
          "aria-label": "Profile",
          data: { action: "mousedown->page-nav#activate" } do %>
      <div class="hidden text-right sm:block">
        <p class="text-sm font-semibold leading-tight text-text-main"><%= current_user.name.presence || current_user.email %></p>
        <div class="mt-0.5 flex justify-end">
          <%= role_badge(current_user) %>
        </div>
      </div>
      <%= user_photo_tag(current_user, size: 40) %>
    <% end %>
  </div>
</header>
