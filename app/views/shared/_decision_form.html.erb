<%# Locals: url, button_label, button_classes, reason_templates, comment_label,
            confirm (optional).

    Reviewers must pick a canned template (sent as-is) or Other (free text). %>
<% other_value = DecisionReasons::OTHER_REASON %>
<div data-controller="reason-template"
     data-reason-template-templates-value="<%= reason_templates.to_h { |t| [ t.id.to_s, t.message_text ] }.to_json %>"
     data-reason-template-other-value="<%= other_value %>">
  <%= form_with url: url, method: :patch, class: "space-y-4",
        data: (local_assigns[:confirm] ? { turbo_confirm: local_assigns[:confirm] } : {}) do %>
    <div>
      <label class="block text-sm font-medium text-slate-700">Reason</label>
      <%= select_tag :reason_template_id,
            options_for_select(
              reason_templates.map { |t| [ truncate(t.message_text, length: 80), t.id ] } +
              [[ "Other — write your own message", other_value ]]
            ),
            prompt: "Choose a reason",
            required: true,
            class: admin_input_classes,
            data: { reason_template_target: "select", action: "change->reason-template#changed" } %>
    </div>

    <div data-reason-template-target="preview" class="hidden rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Message to send</p>
      <p data-reason-template-target="previewText" class="mt-1 whitespace-pre-wrap text-sm text-slate-700"></p>
    </div>

    <div data-reason-template-target="otherField" class="hidden">
      <label class="block text-sm font-medium text-slate-700"><%= comment_label %></label>
      <%= text_area_tag :comment, "", rows: 3, class: admin_input_classes,
            data: { reason_template_target: "comment" } %>
    </div>

    <%= submit_tag button_label, class: "cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition #{button_classes}" %>
  <% end %>
</div>
