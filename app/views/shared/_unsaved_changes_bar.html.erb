<%#
  Shared fixed bottom unsaved-changes bar.
  Locals:
    hint:          subtitle under "Unsaved changes"
    discard_path:  URL for Discard (full reload)
    save_action:   Stimulus action string for Save (e.g. "click->unsaved-changes#save")
    save_label:    button label (default "Save changes")
%>
<div class="scats-unsaved-bar pointer-events-none hidden"
     data-unsaved-changes-target="unsavedBar">
  <div class="scats-unsaved-bar__card pointer-events-auto">
    <div class="flex min-w-0 items-start gap-3 sm:items-center">
      <span class="relative mt-1.5 flex h-2.5 w-2.5 shrink-0 sm:mt-0">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-slate-900">Unsaved changes</p>
        <p class="mt-0.5 text-xs leading-relaxed text-slate-500"><%= hint %></p>
      </div>
    </div>
    <div class="flex w-full flex-col-reverse gap-2 sm:w-auto sm:flex-row sm:items-center sm:gap-2.5">
      <%= link_to "Discard", discard_path,
            data: { turbo: false, action: "click->unsaved-changes#allowLeave" },
            class: "inline-flex w-full items-center justify-center rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700 sm:w-auto" %>
      <button type="button"
              data-action="<%= save_action %>"
              class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-secondary-container focus:ring-offset-2 sm:w-auto">
        <span class="material-symbols-outlined text-lg" aria-hidden="true">save</span>
        <%= local_assigns.fetch(:save_label, "Save changes") %>
      </button>
    </div>
  </div>
</div>
