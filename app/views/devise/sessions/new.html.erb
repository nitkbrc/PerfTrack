<div class="mx-auto w-full max-w-md">
  <div class="clay-card p-8">
    <h1 class="mb-1 text-center text-2xl font-bold text-primary">Welcome back</h1>
    <p class="mb-6 text-center text-sm text-text-muted">Sign in to your SCATS account</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: admin_label_classes %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "#{admin_input_classes} mt-1" %>
      </div>

      <div>
        <%= f.label :password, class: admin_label_classes %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "#{admin_input_classes} mt-1" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me,
                class: "h-4 w-4 shrink-0 rounded border-border-subtle text-primary focus:ring-2 focus:ring-secondary-container/40" %>
          <%= f.label :remember_me, class: "text-sm text-text-main" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log in", class: "scats-primary-button w-full" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
