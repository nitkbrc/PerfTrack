<% forced = current_user.password_change_required? %>

<% if forced %>
  <%= render "shared/campus_background", intensity: :full %>
<% end %>

<div class="relative mx-auto grid <%= forced ? 'min-h-screen place-items-center px-5 py-10' : '' %> w-full max-w-md">
  <section class="<%= forced ? 'glass-panel' : 'clay-card' %> w-full p-7 sm:p-8">
    <h1 class="text-2xl font-bold text-[#000666]">
      <%= forced ? "Set your password" : "Change your password" %>
    </h1>
    <% if forced %>
      <p class="mt-1 text-sm text-[#6C757D]">Your account was set up with a temporary password. Please choose your own to continue.</p>
    <% else %>
      <p class="mt-1 text-sm text-[#6C757D]">Enter your current password, then choose a new one.</p>
    <% end %>

    <%= form_with model: @user, url: account_password_path, method: :put, scope: :user, class: "mt-6 space-y-4" do |f| %>
      <%= render "admin/shared/error_messages", record: @user %>

      <div>
        <%= f.label :current_password, class: "block text-sm font-medium text-[#212529]" %>
        <%= f.password_field :current_password, autofocus: true, autocomplete: "current-password",
              class: "mt-1 w-full rounded-md border border-[#DEE2E6] bg-white px-3 py-2.5 focus:border-[#000666] focus:outline-none focus:ring-2 focus:ring-[#668efe]/40" %>
      </div>

      <div>
        <%= f.label :password, "New password", class: "block text-sm font-medium text-[#212529]" %>
        <span class="text-xs text-[#6C757D]">(6 characters minimum)</span>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "mt-1 w-full rounded-md border border-[#DEE2E6] bg-white px-3 py-2.5 focus:border-[#000666] focus:outline-none focus:ring-2 focus:ring-[#668efe]/40" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-[#212529]" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "mt-1 w-full rounded-md border border-[#DEE2E6] bg-white px-3 py-2.5 focus:border-[#000666] focus:outline-none focus:ring-2 focus:ring-[#668efe]/40" %>
      </div>

      <%= f.submit "Change my password", class: "scats-primary-button w-full" %>
    <% end %>

    <div class="mt-4 flex items-center justify-center gap-4 text-sm">
      <% unless forced %>
        <%= link_to "Back", root_path, class: "font-medium text-[#000666] hover:text-[#1a237e]" %>
      <% end %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "cursor-pointer font-medium text-[#6C757D] hover:text-[#212529]" %>
    </div>
  </section>
</div>
