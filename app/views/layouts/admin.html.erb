<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SCATS Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <main class="mx-auto mt-8 w-full max-w-6xl px-5 pb-16">
      <%= render "admin/nav" %>

      <% if notice %>
        <div class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" data-turbo-temporary><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" data-turbo-temporary><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
