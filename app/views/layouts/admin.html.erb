<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SCATS Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script>
      try {
        if (sessionStorage.getItem("scats-sidebar-expanded") === "true") {
          document.documentElement.classList.add("sidebar-expanded")
        }
      } catch (e) {}
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#F7FAF7] text-slate-900 antialiased" data-controller="page-nav">
    <%= render "shared/campus_background", intensity: :subtle %>
    <%= render "shared/sidebar" %>
    <main class="scats-main">
      <%= render "shared/flash", width_classes: "" %>
      <%= yield %>
    </main>
    <%= content_for?(:modal) ? yield(:modal) : turbo_frame_tag("modal") %>
    <%= render "shared/bottom_nav" %>
  </body>
</html>
