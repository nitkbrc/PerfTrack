<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SCATS Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#f7faf9] font-sans text-[#212529] antialiased" data-controller="page-nav sidebar">
    <%= render "shared/sidebar" %>
    <div class="scats-shell">
      <%= render "shared/top_bar" %>
      <main class="scats-main">
        <%= render "shared/flash", width_classes: "" %>
        <%= yield %>
      </main>
      <%= render "shared/app_footer" %>
    </div>
    <%= content_for?(:modal) ? yield(:modal) : turbo_frame_tag("modal") %>
    <%= render "shared/leave_guard" %>
  </body>
</html>
